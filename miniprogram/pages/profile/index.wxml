<!-- 静心 -->
<view class="page wing-page profile-page">
  <view class="wing-head" style="padding-top: {{statusBarHeight}}px;">
    <text class="wing-title">静 心</text>
  </view>

  <scroll-view class="wing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wing-body">
      <view class="stats-row">
        <view class="stat">
          <text class="st-num mono-num">{{totalText}}</text>
          <text class="st-label">专注</text>
        </view>
        <view class="stat">
          <text class="st-num mono-num">{{wishCount}}</text>
          <text class="st-label">心愿</text>
        </view>
        <view class="stat">
          <text class="st-num mono-num">{{streak}}</text>
          <text class="st-label">天数</text>
        </view>
      </view>

      <view class="rate-row">
        <text class="rate-num mono-num">{{rate}}%</text>
        <view class="wish-line">
          <view class="wish-fill" style="width: {{rate}}%;"></view>
        </view>
      </view>

      <view class="heat">
        <view class="heat-head">
          <text class="heat-title">三十日</text>
          <text class="heat-today" wx:if="{{todayLabel}}">{{todayLabel}}</text>
        </view>
        <text class="heat-caption" wx:if="{{selText}}">{{selText}}</text>
        <view class="heat-grid">
          <view class="heat-row" wx:for="{{rows}}" wx:for-item="row" wx:key="index">
            <view
              wx:for="{{row}}"
              wx:for-item="cell"
              wx:key="key"
              class="heat-cell l{{cell.level}} {{cell.isToday ? 'today' : ''}}"
              data-date="{{cell.date}}"
              data-count="{{cell.count}}"
              bindtap="onPickCell"
            ></view>
          </view>
          <view class="week-row">
            <text class="week-label" wx:for="{{weekdayLabels}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="sets">
        <view class="set-item">
          <text class="set-name">音效</text>
          <view class="tog {{soundOn ? 'on' : ''}}" hover-class="hover-dim" bindtap="toggleSound">
            <view class="tog-knob"></view>
          </view>
        </view>
        <view class="set-item">
          <text class="set-name">震动</text>
          <view class="tog {{vibrateOn ? 'on' : ''}}" hover-class="hover-dim" bindtap="toggleVibrate">
            <view class="tog-knob"></view>
          </view>
        </view>
        <view class="set-item ambi-item">
          <text class="set-name">氛围</text>
          <view class="ambi-row">
            <text
              wx:for="{{ambienceOptions}}"
              wx:key="id"
              class="ambi-opt {{ambience === item.id ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
              hover-class="hover-dim"
              data-id="{{item.id}}"
              bindtap="onPickAmbience"
            >{{item.name}}</text>
          </view>
        </view>
        <view class="set-item ambi-item last">
          <text class="set-name">主题</text>
          <view class="ambi-row">
            <view
              wx:for="{{themeOptions}}"
              wx:key="id"
              class="ambi-opt theme-opt {{theme === item.id ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
              hover-class="hover-dim"
              data-id="{{item.id}}"
              bindtap="onPickTheme"
            >
              <view class="theme-swatch" style="{{item.swatch}}"></view>
              <text>{{item.name}}</text>
            </view>
          </view>
        </view>
      </view>
      <text class="partner-entry" hover-class="hover-dim" bindtap="openPartner">渠道合作</text>
      <text class="partner-entry" wx:if="{{showAdmin}}" hover-class="hover-dim" bindtap="openAdmin">渠道管理</text>
    </view>
  </scroll-view>

  <hall-dock mode="wing" current="{{3}}" />
</view>
