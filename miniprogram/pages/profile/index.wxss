/* 今日一句 */
.zen {
  padding: 8rpx 8rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.zen-text {
  font-family: var(--serif);
  font-size: 32rpx;
  line-height: 1.7;
  letter-spacing: 6rpx;
  color: rgba(243, 234, 220, 0.85);
}
.zen-from {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.45);
}

/* 称号卡 */
.level-card {
  padding: 32rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(240, 207, 142, 0.14), rgba(240, 207, 142, 0) 60%),
    rgba(255, 236, 200, 0.03);
  border: 1rpx solid rgba(224, 181, 119, 0.16);
}
.level-top {
  display: flex;
  align-items: center;
}
.level-badge {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-family: var(--serif);
  font-size: 40rpx;
  color: #1b130c;
  background: radial-gradient(circle at 35% 30%, #ffe7b8 0%, #e0b577 55%, #a87b46 100%);
  box-shadow: 0 0 28rpx rgba(240, 207, 142, 0.35), inset 0 -4rpx 8rpx rgba(120, 80, 30, 0.35);
}
.level-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.level-title {
  font-family: var(--serif);
  font-size: 38rpx;
  letter-spacing: 8rpx;
  color: #f0cf8e;
}
.level-next {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.45);
}
.level-total {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.lt-num {
  font-size: 36rpx;
  color: rgba(243, 234, 220, 0.9);
}
.lt-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.35);
}
.level-bar {
  margin-top: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(224, 181, 119, 0.12);
  overflow: hidden;
}
.level-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #a87b46, #f0cf8e);
  box-shadow: 0 0 10rpx rgba(240, 207, 142, 0.5);
}

/* 三个数 */
.stats-row {
  display: flex;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 236, 200, 0.025);
  border: 1rpx solid rgba(224, 181, 119, 0.08);
}
.stat {
  flex: 1;
  padding: 24rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat + .stat {
  border-left: 1rpx solid rgba(224, 181, 119, 0.08);
}
.st-num {
  font-size: 40rpx;
  color: #e8c98a;
}
.st-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: rgba(232, 201, 138, 0.55);
}
.st-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.38);
}

/* 近五周：像一页小日历，深浅是叩数 */
.heat {
  margin-top: 48rpx;
}
.heat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.heat-title {
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.6);
}
.heat-sub {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.45);
}
.heat-week {
  display: flex;
  margin-top: 24rpx;
}
.week-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: rgba(240, 230, 216, 0.3);
}
.heat-grid {
  margin-top: 10rpx;
}
.heat-row {
  display: flex;
  margin-bottom: 10rpx;
}
.heat-cell {
  position: relative;
  flex: 1;
  height: 72rpx;
  margin-right: 10rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}
.heat-cell:last-child {
  margin-right: 0;
}
.heat-day {
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  font-size: 18rpx;
  color: rgba(240, 230, 216, 0.32);
  font-variant-numeric: tabular-nums;
}
.heat-cell.l0 {
  background: rgba(255, 255, 255, 0.035);
}
.heat-cell.l1 {
  background: rgba(212, 165, 116, 0.2);
}
.heat-cell.l2 {
  background: rgba(212, 165, 116, 0.4);
}
.heat-cell.l3 {
  background: rgba(224, 181, 119, 0.65);
}
.heat-cell.l4 {
  background: linear-gradient(160deg, #f6d9a0, #d9a866);
  box-shadow: 0 0 16rpx rgba(240, 207, 142, 0.25);
}
.heat-cell.l3 .heat-day,
.heat-cell.l4 .heat-day {
  color: rgba(27, 19, 12, 0.6);
}
.heat-cell.future {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.04);
}
.heat-cell.future .heat-day {
  color: rgba(240, 230, 216, 0.14);
}
.heat-cell.today {
  box-shadow: inset 0 0 0 2rpx rgba(255, 226, 168, 0.85);
}
.heat-cell.sel {
  transform: scale(1.06);
  box-shadow: 0 0 0 2rpx rgba(255, 226, 168, 0.9), 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}
.heat-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.heat-caption {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.55);
}
.legend {
  display: flex;
  align-items: center;
}
.legend-text {
  margin: 0 8rpx;
  font-size: 20rpx;
  color: rgba(240, 230, 216, 0.3);
}
.legend-cell {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
  border-radius: 5rpx;
}
.legend-cell.l1 { background: rgba(212, 165, 116, 0.2); }
.legend-cell.l2 { background: rgba(212, 165, 116, 0.4); }
.legend-cell.l3 { background: rgba(224, 181, 119, 0.65); }
.legend-cell.l4 { background: #e8c48a; }

/* 静心包 */
.pack-card {
  margin-top: 48rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background:
    radial-gradient(120% 160% at 100% 0%, rgba(240, 207, 142, 0.2), rgba(240, 207, 142, 0) 55%),
    linear-gradient(135deg, rgba(60, 42, 24, 0.9), rgba(30, 22, 14, 0.9));
  border: 1rpx solid rgba(232, 201, 138, 0.35);
}
.pack-hover {
  opacity: 0.85;
}
.pack-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.pack-title {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 8rpx;
  color: #f0cf8e;
}
.pack-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.7);
}
.pack-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.pack-go {
  flex-shrink: 0;
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  padding-left: 42rpx;
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 10rpx 24rpx rgba(224, 181, 119, 0.25);
}
.pack-owned {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.5);
}

/* 设置 */
.sets {
  margin-top: 40rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.08);
}
.set-item.last {
  border-bottom: none;
}
.set-item.col {
  height: auto;
  padding: 32rpx 0 28rpx;
  flex-direction: column;
  align-items: stretch;
}
.set-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.set-hint {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.3);
}
.set-name {
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: rgba(240, 230, 216, 0.78);
}

/* 氛围：一排小签，锁着的带一把小锁 */
.ambi-row {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0 0 -8rpx;
}
.ambi-opt {
  margin: 8rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.6);
  border: 1rpx solid rgba(224, 181, 119, 0.2);
}
.ambi-opt.on {
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866);
  border-color: transparent;
}
.ambi-opt.locked {
  color: rgba(240, 230, 216, 0.35);
  border-style: dashed;
}
.ambi-hover {
  background: rgba(224, 181, 119, 0.14);
}

/* 一把小锁：锁身 + 锁梁 */
.lock {
  position: relative;
  width: 16rpx;
  height: 12rpx;
  margin-left: 10rpx;
  margin-top: 6rpx;
  border-radius: 3rpx;
  background: rgba(224, 181, 119, 0.6);
}
.lock::before {
  content: '';
  position: absolute;
  left: 3rpx;
  top: -9rpx;
  width: 6rpx;
  height: 8rpx;
  border: 2rpx solid rgba(224, 181, 119, 0.6);
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
}
.lock.on-swatch {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  margin: 0;
  background: rgba(243, 234, 220, 0.85);
}
.lock.on-swatch::before {
  border-color: rgba(243, 234, 220, 0.85);
}

/* 主题：四枚色块 */
.theme-row {
  display: flex;
  margin-top: 24rpx;
}
.theme-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.theme-swatch {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(240, 230, 216, 0.12);
  transition: transform 0.2s ease;
}
.theme-opt.on .theme-swatch {
  border: 4rpx solid #e8c98a;
  box-shadow: 0 0 24rpx rgba(232, 201, 138, 0.35);
  transform: scale(1.06);
}
.theme-opt.locked .theme-swatch {
  opacity: 0.55;
}
.theme-name {
  margin-top: 12rpx;
  font-family: var(--serif);
  font-size: 26rpx;
  color: rgba(240, 230, 216, 0.5);
}
.theme-opt.on .theme-name {
  color: #e8c98a;
}
/* 色块下面一行小字：哪一套正在用 */
.theme-using {
  height: 28rpx;
  margin-top: 2rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 28rpx;
  color: rgba(224, 181, 119, 0.6);
}

/* 主题小样：左下角写是哪一套、换了什么；没开静心包的右下角一枚金签 */
.stage {
  position: relative;
  margin-top: 24rpx;
}
.stage-cap {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  display: flex;
  flex-direction: column;
  max-width: 210rpx;
  pointer-events: none;
}
.stage-name {
  font-family: var(--serif);
  font-size: 40rpx;
  line-height: 1.2;
  color: rgba(243, 234, 220, 0.92);
}
.stage-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.45;
  letter-spacing: 1rpx;
  color: rgba(243, 234, 220, 0.55);
}
.stage-lock {
  position: absolute;
  right: 20rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}
.lock.dark {
  margin: 4rpx 10rpx 0 0;
  background: rgba(27, 19, 12, 0.8);
}
.lock.dark::before {
  border-color: rgba(27, 19, 12, 0.8);
}

/* 正在试听：三根跳动的小竖条 */
.wave {
  display: flex;
  align-items: flex-end;
  height: 22rpx;
  margin-right: 10rpx;
}
.wb {
  width: 4rpx;
  height: 100%;
  margin-right: 3rpx;
  border-radius: 2rpx;
  background: #e8c98a;
  transform-origin: 50% 100%;
  animation: wave-bar 0.9s ease-in-out infinite;
}
.wb:nth-child(2) {
  animation-delay: -0.3s;
}
.wb:nth-child(3) {
  margin-right: 0;
  animation-delay: -0.6s;
}
.ambi-opt.on .wb {
  background: #1b130c;
}
@keyframes wave-bar {
  0%,
  100% {
    transform: scaleY(0.35);
  }
  50% {
    transform: scaleY(1);
  }
}

/* ===== 静心包介绍面板 ===== */
.ps-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  transition: opacity 0.28s ease;
}
.ps-mask.show {
  opacity: 1;
}
.ps {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  height: 86vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, #211810 0%, #140f0a 100%);
  border-top: 1rpx solid rgba(232, 201, 138, 0.25);
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.5);
  transform: translateY(100%);
  transition: transform 0.28s ease;
}
.ps.show {
  transform: translateY(0);
}
.ps-grip {
  flex-shrink: 0;
  width: 72rpx;
  height: 8rpx;
  margin: 18rpx auto 6rpx;
  border-radius: 4rpx;
  background: rgba(240, 230, 216, 0.2);
}
.ps-scroll {
  flex: 1;
  min-height: 0;
}
.ps-body {
  padding: 16rpx 40rpx 32rpx;
}
.ps-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.ps-title {
  font-family: var(--serif);
  font-size: 44rpx;
  letter-spacing: 10rpx;
  color: #f0cf8e;
}
.ps-price {
  font-size: 34rpx;
  color: #f0cf8e;
}
.ps-lead {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(243, 234, 220, 0.7);
}
.ps-sec {
  margin-top: 44rpx;
}
.ps-sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ps-sec-name {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.9);
}
.ps-sec-hint {
  font-size: 22rpx;
  color: rgba(243, 234, 220, 0.36);
}
.ps-ambi {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.ps-ambi-opt {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 1rpx solid rgba(224, 181, 119, 0.2);
  background: rgba(255, 236, 200, 0.03);
  transition: border-color 0.2s ease, background 0.2s ease;
}
.ps-ambi-opt.playing {
  border-color: rgba(232, 201, 138, 0.7);
  background: rgba(224, 181, 119, 0.1);
}
.ps-ambi-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 40rpx;
}
.ps-ambi-name {
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.88);
}
.ps-play {
  font-size: 20rpx;
  color: rgba(224, 181, 119, 0.7);
}
.ps-ambi-opt .wave {
  margin-right: 0;
}
.ps-ambi-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(243, 234, 220, 0.42);
}
.ps-themes {
  display: flex;
  margin: 16rpx -6rpx 0;
}
.ps-theme {
  flex: 1;
  margin: 0 6rpx;
  padding: 16rpx 8rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}
.ps-theme.on {
  border-color: rgba(232, 201, 138, 0.3);
  background: rgba(224, 181, 119, 0.08);
}
.ps-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(240, 230, 216, 0.14);
}
.ps-theme.on .ps-swatch {
  border: 3rpx solid #e8c98a;
  box-shadow: 0 0 16rpx rgba(232, 201, 138, 0.35);
}
.ps-theme-text {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ps-theme-name {
  font-family: var(--serif);
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.7);
}
.ps-theme.on .ps-theme-name {
  color: #e8c98a;
}
.ps-theme-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
  color: rgba(243, 234, 220, 0.4);
}
.ps-plan {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(224, 181, 119, 0.16);
  background: rgba(255, 236, 200, 0.025);
}
.ps-plan-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.ps-plan-name {
  font-family: var(--serif);
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: #f0cf8e;
}
.ps-plan-min {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(224, 181, 119, 0.6);
}
/* 从香案这套定课过来的：框亮一点，名字后标「刚试过」 */
.ps-plan.from {
  border-color: rgba(224, 181, 119, 0.5);
  background: rgba(224, 181, 119, 0.07);
}
.ps-plan-tried {
  margin-left: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #16110d;
  background: rgba(224, 181, 119, 0.85);
}
.ps-plan-scene {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(243, 234, 220, 0.75);
}
.ps-plan-mix {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(243, 234, 220, 0.42);
}
.ps-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(224, 181, 119, 0.55);
}
.ps-foot {
  flex-shrink: 0;
  padding: 20rpx 40rpx 0;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.ps-buy {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 10rpx 24rpx rgba(224, 181, 119, 0.25);
}
.ps-owned {
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.7);
}

.partner-entry {
  display: block;
  margin-top: 64rpx;
  padding-bottom: 24rpx;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  color: #e8c98a;
}
.sign-off {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  font-family: var(--serif);
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: rgba(240, 230, 216, 0.2);
}

.tog {
  position: relative;
  width: 84rpx;
  height: 44rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(224, 181, 119, 0.24);
  transition: background 0.28s ease, border-color 0.28s ease;
}
.tog-knob {
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(224, 181, 119, 0.4);
  transition: transform 0.28s ease, background 0.28s ease;
}
.tog.on {
  background: rgba(224, 181, 119, 0.2);
  border-color: rgba(232, 201, 138, 0.6);
}
.tog.on .tog-knob {
  transform: translateX(40rpx);
  background: #f0cf8e;
  box-shadow: 0 0 12rpx rgba(240, 207, 142, 0.6);
}

/* 九境：点开称号卡看全部 */
.level-hover {
  opacity: 0.9;
}
.ladder {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.12);
}
.ladder-row {
  display: flex;
  align-items: center;
  height: 64rpx;
  font-size: 26rpx;
  color: rgba(243, 234, 220, 0.32);
}
.ladder-lv {
  width: 48rpx;
  font-size: 22rpx;
}
.ladder-title {
  flex: 1;
  font-family: var(--serif);
  letter-spacing: 6rpx;
}
.ladder-need {
  font-size: 22rpx;
}
.ladder-row.reached {
  color: rgba(232, 201, 138, 0.7);
}
.ladder-row.cur {
  color: #f0cf8e;
}
.ladder-row.cur .ladder-title::after {
  content: ' · 此境';
  font-family: -apple-system, 'PingFang SC', sans-serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
.ladder-toggle {
  display: block;
  margin-top: 16rpx;
  text-align: right;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.5);
}
