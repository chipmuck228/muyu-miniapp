.stats-row {
  display: flex;
  padding: 24rpx 0 8rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.st-num {
  font-size: 40rpx;
  font-weight: 400;
  color: #e8c98a;
}
.st-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 8rpx;
  padding-right: 8rpx;
  color: rgba(240, 230, 216, 0.35);
}

.rate-row {
  padding: 28rpx 8rpx 8rpx;
}
.rate-num {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.wish-line {
  height: 2rpx;
  background: rgba(224, 181, 119, 0.12);
}
.wish-fill {
  height: 100%;
  background: rgba(224, 181, 119, 0.55);
}

.heat {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.heat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.heat-title {
  font-size: 22rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.heat-today {
  font-size: 22rpx;
  color: rgba(224, 181, 119, 0.45);
}
.heat-caption {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.32);
}

.heat-grid {
  margin-top: 20rpx;
}
.heat-row {
  display: flex;
  margin-bottom: 8rpx;
}
.heat-cell {
  flex: 1;
  height: 28rpx;
  margin-right: 8rpx;
}
.heat-cell:last-child {
  margin-right: 0;
}
.heat-cell.l0 {
  background: rgba(255, 255, 255, 0.04);
}
.heat-cell.l1 {
  background: rgba(212, 165, 116, 0.18);
}
.heat-cell.l2 {
  background: rgba(212, 165, 116, 0.38);
}
.heat-cell.l3 {
  background: rgba(212, 165, 116, 0.62);
}
.heat-cell.l4 {
  background: rgba(212, 165, 116, 0.88);
}
.heat-cell.today {
  box-shadow: inset 0 0 0 1rpx rgba(244, 207, 142, 0.7);
}

.week-row {
  display: flex;
  margin-top: 8rpx;
}
.week-label {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: rgba(240, 230, 216, 0.28);
}

.sets {
  margin-top: 40rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.08);
}
.set-item.last {
  border-bottom: none;
}
.set-name {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: rgba(240, 230, 216, 0.72);
}
.coming {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.22);
}
.set-item switch {
  transform: scale(0.78);
  transform-origin: right center;
}
