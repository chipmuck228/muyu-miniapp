.list-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.38);
}
.wishes-page .empty {
  padding-top: 160rpx;
}
.wishes-page .empty-title {
  margin-top: 0;
  font-size: 28rpx;
  letter-spacing: 10rpx;
  font-weight: 400;
  color: rgba(240, 230, 216, 0.55);
}
.empty-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.42);
}

.wish-row {
  padding: 32rpx 0 26rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.08);
}
.wish-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wish-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wish-mark {
  margin-left: 24rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.5);
}
.wish-row.done .wish-name {
  color: rgba(240, 230, 216, 0.42);
}
.wish-row.done .wish-mark {
  color: rgba(224, 181, 119, 0.32);
}
.wish-line {
  margin-top: 18rpx;
  height: 2rpx;
  background: rgba(224, 181, 119, 0.12);
}
.wish-fill {
  height: 100%;
  background: rgba(224, 181, 119, 0.55);
}

.wishes-page .wing-kicker {
  width: 140rpx;
}
.add-kicker {
  text-align: right;
  white-space: nowrap;
  color: rgba(224, 181, 119, 0.8);
}
.wishes-page .empty-go {
  margin-top: 36rpx;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: #e0b577;
}
