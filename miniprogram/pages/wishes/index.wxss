.wishes-page .empty {
  padding-top: 160rpx;
}
.wishes-page .empty-title {
  margin-top: 0;
  font-size: 28rpx;
  letter-spacing: 10rpx;
  font-weight: 400;
  color: rgba(240, 230, 216, 0.55);
}
.empty-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.42);
}

.wish-row {
  padding: 28rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.08);
}
.wish-name {
  display: block;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wish-line {
  margin-top: 18rpx;
  height: 2rpx;
  background: rgba(224, 181, 119, 0.12);
}
.wish-fill {
  height: 100%;
  background: rgba(224, 181, 119, 0.55);
}
