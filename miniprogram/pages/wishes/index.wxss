.list-hint {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.38);
}

.wishes-page .wing-kicker {
  width: 140rpx;
}
.add-kicker {
  text-align: right;
  white-space: nowrap;
  color: rgba(224, 181, 119, 0.8);
}

/* 分组标题：进行中 / 已圆满 */
.group-head {
  display: flex;
  align-items: baseline;
  margin: 36rpx 0 16rpx;
}
.group-name {
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.6);
}
.group-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: rgba(224, 181, 119, 0.38);
  font-variant-numeric: tabular-nums;
}
.done-head {
  margin-top: 56rpx;
}

/* 进行中的心愿：一张卡，名字 + 百分比，下面进度条和数字 */
.wish-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 30rpx 32rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, rgba(255, 236, 200, 0.055) 0%, rgba(255, 236, 200, 0.02) 100%);
  border: 1rpx solid rgba(224, 181, 119, 0.12);
  transition: transform 0.15s ease, background 0.15s ease;
}
.wish-card-hover {
  transform: scale(0.985);
  background: rgba(255, 236, 200, 0.08);
}
.wish-card.cur {
  border-color: rgba(232, 201, 138, 0.38);
  box-shadow: 0 0 32rpx rgba(232, 201, 138, 0.08);
}
.wish-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wish-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wish-pct {
  margin-left: 24rpx;
  font-size: 40rpx;
  color: #e8c98a;
}
.pct-sign {
  margin-left: 2rpx;
  font-size: 24rpx;
  color: rgba(232, 201, 138, 0.6);
}
.wish-bar {
  margin-top: 20rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(224, 181, 119, 0.1);
  overflow: hidden;
}
.wish-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #a87b46, #e0b577);
}
.wish-card.near .wish-bar-fill {
  background: linear-gradient(90deg, #d9a866, #ffe2a8);
  box-shadow: 0 0 12rpx rgba(255, 220, 160, 0.7);
}
.wish-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.42);
}
.wish-nums {
  color: rgba(243, 234, 220, 0.5);
}
.wish-today {
  margin-left: 20rpx;
  color: rgba(232, 201, 138, 0.75);
}
.wish-due,
.wish-cur {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: rgba(232, 201, 138, 0.85);
  background: rgba(224, 181, 119, 0.1);
}
.wish-due.late {
  color: rgba(240, 150, 120, 0.9);
  background: rgba(220, 110, 80, 0.12);
}
.wish-cur {
  color: #1b130c;
  background: rgba(232, 201, 138, 0.85);
}
.wish-detail {
  margin-left: auto;
  padding: 8rpx 0 8rpx 32rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.8);
}

/* 已圆满：一枚小印 + 名字 + 日期 */
.done-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.08);
}
.seal {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(196, 72, 56, 0.85);
  border-radius: 8rpx;
  transform: rotate(-8deg);
  font-family: var(--serif);
  font-size: 30rpx;
  color: rgba(214, 88, 70, 0.95);
  box-shadow: inset 0 0 0 3rpx rgba(14, 10, 8, 1), inset 0 0 0 5rpx rgba(196, 72, 56, 0.5);
}
.seal.fulfilled {
  border-color: rgba(224, 181, 119, 0.7);
  color: #e8c98a;
  box-shadow: inset 0 0 0 3rpx rgba(14, 10, 8, 1), inset 0 0 0 5rpx rgba(224, 181, 119, 0.4);
}
.done-text {
  flex: 1;
  min-width: 0;
}
.done-name {
  display: block;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.done-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.36);
  font-variant-numeric: tabular-nums;
}
.done-go {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.55);
}

/* 列表末尾的立愿入口，和今日功课面板写法一致 */
.wish-new {
  margin-top: 24rpx;
  padding: 32rpx 0;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.85);
  border: 1rpx dashed rgba(224, 181, 119, 0.28);
  border-radius: 24rpx;
}

/* 首次加载的占位 */
.sk-row {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 236, 200, 0.03);
}
.sk-line {
  height: 26rpx;
  margin-top: 18rpx;
  border-radius: 13rpx;
  background: linear-gradient(90deg, rgba(255, 236, 200, 0.05) 0%, rgba(255, 236, 200, 0.11) 50%, rgba(255, 236, 200, 0.05) 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
.sk-line:first-child {
  margin-top: 0;
}
.sk-line.thin {
  height: 6rpx;
}
.sk-line.w60 { width: 60%; }
.sk-line.w100 { width: 100%; }
.sk-line.w30 { width: 30%; }
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 空列表 */
.wishes-page .empty {
  padding-top: 120rpx;
}
.wishes-page .empty-title {
  margin-top: 0;
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 12rpx;
  font-weight: 400;
  color: rgba(243, 234, 220, 0.8);
}
.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.5);
}
.wishes-page .empty-go {
  margin-top: 56rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 12rpx 32rpx rgba(224, 181, 119, 0.22);
}
.empty-lotus {
  position: relative;
  width: 120rpx;
  height: 92rpx;
  margin-bottom: 40rpx;
}
.el-petal {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 42rpx;
  height: 86rpx;
  margin-left: -21rpx;
  border-radius: 50% 50% 46% 46% / 60% 60% 40% 40%;
  background: linear-gradient(180deg, rgba(240, 214, 170, 0.6), rgba(180, 130, 70, 0.1));
  transform-origin: 50% 100%;
}
.el-petal.l { transform: rotate(-40deg); opacity: 0.7; }
.el-petal.r { transform: rotate(40deg); opacity: 0.7; }
.ideas-label {
  margin-top: 72rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(243, 234, 220, 0.3);
}
.ideas {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}
.idea {
  margin: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.65);
  border: 1rpx solid rgba(224, 181, 119, 0.22);
}
.idea-hover {
  background: rgba(224, 181, 119, 0.14);
}
