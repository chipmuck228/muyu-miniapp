<!-- 心愿详情：侧殿里的一纸，叩击回堂 -->
<view class="page wing-page detail-page">
  <view class="wing-head has-kicker" style="padding-top: {{statusBarHeight}}px;">
    <text class="wing-kicker" hover-class="hover-dim" bindtap="goBack">返回</text>
    <text class="wing-title slim">{{wish ? wish.name : ''}}</text>
    <text
      class="wing-kicker {{canEdit ? '' : 'ghost'}}"
      hover-class="hover-dim"
      bindtap="goEdit"
    >改愿</text>
  </view>

  <scroll-view wx:if="{{!loading && wish}}" class="wing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wing-body detail-body">
      <text class="status-word">{{wish.statusText}}</text>
      <text class="status-date" wx:if="{{wish.status === 'completed' && wish.completedDate}}">已成于 {{wish.completedDate}}</text>
      <text class="status-date" wx:elif="{{wish.status === 'fulfilled' && wish.fulfilledDate}}">已了结于 {{wish.fulfilledDate}}</text>

      <view class="reveal" wx:if="{{revealed}}">
        <image
          wx:if="{{thumbUrl}}"
          class="reveal-img {{revealOn ? 'on' : ''}}"
          src="{{thumbUrl}}"
          mode="aspectFill"
        />
        <text class="reveal-hint">惊喜已启</text>
      </view>
      <text class="blind-hint" wx:elif="{{wish.status === 'ongoing'}}">完成后另有惊喜</text>

      <view class="wish-line">
        <view class="wish-fill" style="width: {{wish.percent}}%;"></view>
      </view>
      <view class="nums">
        <text class="num-cur mono-num">{{wish.currentText}}</text>
        <text class="num-slash">/</text>
        <text class="num-goal mono-num">{{wish.goalText}}</text>
      </view>

      <view class="block">
        <view class="block-head">
          <text class="block-label">近十四日</text>
          <text class="block-sub" wx:if="{{localToday}}">今日 {{localToday}}</text>
        </view>
        <view class="chart">
          <view class="chart-col" wx:for="{{bars}}" wx:key="key">
            <view class="bar-wrap">
              <view class="bar {{item.hasValue ? 'val' : ''}} {{item.isToday ? 'today' : ''}}" style="height: {{item.ratio}}%;"></view>
            </view>
            <text class="bar-label {{item.isToday ? 'today' : ''}}">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="block">
        <text class="block-label">叩击</text>
        <block wx:if="{{records.length > 0}}">
          <view class="record-row" wx:for="{{records}}" wx:key="date">
            <text class="record-date">{{item.text}}</text>
            <text class="record-count mono-num">{{item.count}}</text>
          </view>
        </block>
        <text class="no-record" wx:else>尚未叩击</text>
      </view>
    </view>
  </scroll-view>

  <view class="foot" wx:if="{{!loading && wish && (canKnock || showFulfill || canSave)}}" style="padding-bottom: {{safeBottom}}px;">
    <text wx:if="{{canKnock}}" class="foot-act" hover-class="hover-dim" bindtap="goAltar">回堂叩击</text>
    <text wx:if="{{showFulfill}}" class="foot-act" hover-class="hover-dim" bindtap="doFulfill">了结</text>
    <text wx:if="{{canSave}}" class="foot-act {{savingPaper ? 'off' : ''}}" hover-class="hover-dim" bindtap="savePaper">存入相册</text>
  </view>

  <view wx:if="{{!loading && !wish}}" class="empty">
    <text class="empty-title">心愿已不在</text>
    <text class="empty-sub" hover-class="hover-dim" bindtap="goBack">返回</text>
  </view>
</view>
