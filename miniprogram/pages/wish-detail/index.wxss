.detail-page {
  background:
    radial-gradient(120% 45% at 50% -5%, rgba(212, 165, 116, 0.09), rgba(212, 165, 116, 0) 60%),
    linear-gradient(180deg, #1c1510 0%, #14100c 100%);
}

.detail-scroll {
  flex: 1;
  min-height: 0;
}
.detail-body {
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
}

/* Hero */
.hero-card {
  padding: 26rpx 28rpx;
}
.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-date {
  font-size: 22rpx;
  color: rgba(240, 230, 216, 0.4);
}
.hero-name {
  display: block;
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #f0e6d8;
  word-break: break-all;
}
.big-track {
  margin-top: 26rpx;
  height: 18rpx;
  border-radius: 9rpx;
}
.hero-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hf-nums {
  font-size: 24rpx;
}
.hf-percent {
  font-size: 30rpx;
  font-weight: 700;
  color: #f4cf8e;
}

/* 统计三列 */
.stats-row {
  margin-top: 20rpx;
  display: flex;
}
.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 10rpx;
  margin-right: 16rpx;
}
.stat-card:last-child {
  margin-right: 0;
}
.st-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0e6d8;
}
.st-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(240, 230, 216, 0.45);
}

/* 图表 */
.chart-card,
.records-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 18rpx;
}
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
}
.st-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(240, 230, 216, 0.4);
}
.chart {
  margin-top: 26rpx;
  height: 230rpx;
  display: flex;
  align-items: flex-end;
}
.chart-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 20rpx;
  min-height: 6rpx;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  background: rgba(212, 165, 116, 0.16);
  transition: height 0.3s ease;
}
.bar.val {
  background: linear-gradient(180deg, #d9a75f, #8a5a28);
}
.bar.today {
  background: linear-gradient(180deg, #ffe0a3, #d9a659);
  box-shadow: 0 0 16rpx rgba(233, 182, 106, 0.65);
}
.bar-label {
  margin-top: 10rpx;
  font-size: 16rpx;
  color: rgba(240, 230, 216, 0.3);
  line-height: 1;
}
.bar-label.today {
  color: #f4cf8e;
  font-weight: 600;
}

/* 记录列表 */
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.045);
}
.record-row:last-child {
  border-bottom: none;
}
.record-date {
  font-size: 26rpx;
  color: rgba(240, 230, 216, 0.75);
}
.record-count {
  font-size: 24rpx;
  color: #e0b577;
}
.no-record {
  padding: 40rpx 0 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(240, 230, 216, 0.3);
}

.action-space {
  height: 240rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx 20rpx;
  box-sizing: content-box;
  background: linear-gradient(180deg, rgba(20, 16, 12, 0), #16110d 40%);
  pointer-events: none;
}
.action-bar > view {
  pointer-events: auto;
}
.ab-edit {
  position: absolute;
  left: 48rpx;
  bottom: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: rgba(240, 230, 216, 0.6);
  padding: 10rpx 16rpx;
}
.ab-edit-icon {
  font-size: 36rpx;
  line-height: 1.2;
}
.ab-knock {
  position: relative;
  width: 236rpx;
  height: 236rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 36% 28%, #e2ac63, #b98141 44%, #8a5a28 74%, #623d1c 100%);
  box-shadow:
    0 20rpx 48rpx rgba(0, 0, 0, 0.5),
    inset 0 -16rpx 40rpx rgba(40, 18, 2, 0.55),
    inset 0 10rpx 30rpx rgba(255, 232, 196, 0.25);
}
.ab-knock-hover {
  transform: scale(0.94);
}
.ab-knock-face {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 30rpx;
  bottom: 30rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(90, 52, 16, 0.5);
}
.ab-knock-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #ffe9c2;
  text-shadow: 0 2rpx 8rpx rgba(40, 20, 0, 0.5);
}
.ab-fulfill {
  height: 100rpx;
  padding: 0 80rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2b1d0f;
  background: linear-gradient(135deg, #f0c98a, #c0955f);
  box-shadow: 0 12rpx 32rpx rgba(212, 165, 116, 0.28);
}

.empty-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-btn {
  margin-top: 40rpx;
  padding: 18rpx 64rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b1d0f;
  background: linear-gradient(135deg, #f0c98a, #c0955f);
}
