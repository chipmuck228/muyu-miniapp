.detail-page {
  background:
    radial-gradient(110% 48% at 50% -8%, rgba(224, 181, 119, 0.06), rgba(224, 181, 119, 0) 58%),
    linear-gradient(180deg, #120e0a 0%, #0a0806 100%);
}

.detail-body {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.status-word {
  display: block;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.status-date {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.28);
}

.reveal {
  margin-top: 36rpx;
}
.reveal-img {
  display: block;
  width: 100%;
  height: 420rpx;
  opacity: 0;
  transition: opacity 720ms ease;
  background: rgba(224, 181, 119, 0.06);
}
.reveal-img.on {
  opacity: 1;
}
.reveal-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: rgba(224, 181, 119, 0.45);
}
.blind-hint {
  display: block;
  margin-top: 28rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.32);
}

.wish-line {
  margin-top: 28rpx;
  height: 2rpx;
  background: rgba(224, 181, 119, 0.12);
}
.wish-fill {
  height: 100%;
  background: rgba(224, 181, 119, 0.55);
}

.nums {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}
.num-cur {
  font-size: 40rpx;
  color: #e8c98a;
}
.num-slash {
  margin: 0 10rpx;
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.22);
}
.num-goal {
  font-size: 30rpx;
  color: rgba(240, 230, 216, 0.4);
}

.block {
  margin-top: 56rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.block-label {
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.block-sub {
  font-size: 26rpx;
  color: rgba(224, 181, 119, 0.4);
}

.chart {
  margin-top: 28rpx;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
}
.chart-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 2rpx;
  min-height: 4rpx;
  background: rgba(224, 181, 119, 0.12);
}
.bar.val {
  background: rgba(224, 181, 119, 0.45);
}
.bar.today {
  background: #e8c98a;
}
.bar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(240, 230, 216, 0.22);
  line-height: 1;
}
.bar-label.today {
  color: rgba(232, 201, 138, 0.7);
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.06);
}
.record-row:last-child {
  border-bottom: none;
}
.record-date {
  font-size: 30rpx;
  color: rgba(240, 230, 216, 0.62);
}
.record-count {
  font-size: 28rpx;
  color: rgba(224, 181, 119, 0.55);
}
.no-record {
  display: block;
  padding: 36rpx 0 8rpx;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: rgba(240, 230, 216, 0.28);
}

.foot {
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  padding: 8rpx 32rpx 20rpx;
}
.foot-act {
  font-size: 32rpx;
  letter-spacing: 12rpx;
  padding: 16rpx 24rpx 16rpx 36rpx;
  color: #e8c98a;
}
.foot-act.off {
  opacity: 0.35;
  pointer-events: none;
}

.detail-page .empty {
  flex: 1;
  padding-top: 160rpx;
}
.detail-page .empty-title {
  margin-top: 0;
  font-size: 32rpx;
  letter-spacing: 10rpx;
  font-weight: 400;
  color: rgba(240, 230, 216, 0.55);
}
.detail-page .empty-sub {
  margin-top: 28rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  color: rgba(224, 181, 119, 0.55);
}
