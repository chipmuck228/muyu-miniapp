.cert-page .empty {
  padding-top: 72rpx;
}
.cert-page .empty-title {
  margin-top: 48rpx;
  font-family: var(--serif);
  font-size: 34rpx;
  letter-spacing: 12rpx;
  font-weight: 400;
  color: rgba(243, 234, 220, 0.75);
}
.cert-page .empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.5);
}

/* 空的时候：一张淡淡的空白证书 */
.ghost-paper {
  position: relative;
  width: 280rpx;
  height: 392rpx;
  padding: 72rpx 40rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 6rpx;
  background: linear-gradient(180deg, rgba(246, 237, 220, 0.09), rgba(230, 211, 180, 0.04));
  border: 1rpx solid rgba(224, 181, 119, 0.18);
  box-shadow: inset 0 0 0 10rpx rgba(14, 10, 8, 0.6), inset 0 0 0 11rpx rgba(224, 181, 119, 0.12);
}
.gp-line {
  height: 10rpx;
  margin-top: 28rpx;
  border-radius: 5rpx;
  background: rgba(224, 181, 119, 0.14);
}
.gp-line.w40 { width: 40%; }
.gp-line.w70 { width: 70%; height: 16rpx; margin-top: 44rpx; }
.gp-line.w50 { width: 50%; }
.gp-seal {
  position: absolute;
  right: 40rpx;
  bottom: 44rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 4rpx;
  border: 2rpx dashed rgba(196, 72, 56, 0.45);
  transform: rotate(-6deg);
}
.near {
  margin-top: 56rpx;
  width: 100%;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  text-align: left;
  border-radius: 20rpx;
  background: rgba(255, 236, 200, 0.04);
  border: 1rpx solid rgba(224, 181, 119, 0.14);
}
.near-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.near-name {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.88);
}
.near-pct {
  font-size: 32rpx;
  color: #e8c98a;
}
.near-bar {
  margin-top: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(224, 181, 119, 0.1);
  overflow: hidden;
}
.near-fill {
  height: 100%;
  background: linear-gradient(90deg, #a87b46, #f0cf8e);
}
.near-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 201, 138, 0.65);
}
.near-go {
  margin-top: 56rpx;
  padding: 0 56rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: #e8c98a;
  border: 1rpx solid rgba(224, 181, 119, 0.4);
}

.congrats {
  display: flex;
  justify-content: center;
  padding: 0 0 24rpx;
}
.cong-title {
  font-size: 24rpx;
  letter-spacing: 8rpx;
  color: rgba(224, 181, 119, 0.55);
}

/* 多张证书：横着一排，可滑 */
.cert-tabs {
  margin: 0 -40rpx 28rpx;
  width: calc(100% + 80rpx);
  white-space: nowrap;
}
.cert-tabs-inner {
  display: inline-flex;
  padding: 0 40rpx;
}
.cert-tab {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 14rpx 24rpx;
  display: flex;
  flex-direction: column;
  border-radius: 18rpx;
  border: 1rpx solid rgba(224, 181, 119, 0.14);
  background: rgba(255, 236, 200, 0.02);
}
.cert-tab.on {
  border-color: rgba(232, 201, 138, 0.6);
  background: rgba(224, 181, 119, 0.1);
}
.tab-name {
  max-width: 280rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
}
.cert-tab.on .tab-name {
  color: #f0cf8e;
}
.tab-date {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(243, 234, 220, 0.3);
}

/* 证书像一张纸平放在暗处：投影 + 极细的金边 */
.paper-frame {
  margin: 8rpx 12rpx 0;
  border-radius: 6rpx;
  overflow: hidden;
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.6), 0 0 0 1rpx rgba(224, 181, 119, 0.2);
}
.paper-img {
  display: block;
  width: 100%;
  height: auto;
}
.paper-placeholder {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 140%;
  background: linear-gradient(90deg, rgba(244, 234, 216, 0.06) 0%, rgba(244, 234, 216, 0.12) 50%, rgba(244, 234, 216, 0.06) 100%);
  background-size: 200% 100%;
  animation: paper-shimmer 1.4s ease-in-out infinite;
}
.ph-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 46%;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.45);
}
@keyframes paper-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.actions {
  margin-top: 48rpx;
  display: flex;
}
.act {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  padding-left: 8rpx;
  color: #e8c98a;
  border: 1rpx solid rgba(224, 181, 119, 0.4);
}
.act + .act {
  margin-left: 20rpx;
}
.act.primary {
  color: #1b130c;
  border-color: transparent;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 12rpx 32rpx rgba(224, 181, 119, 0.22);
}
.act-hover {
  opacity: 0.8;
}
.tip {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.28);
}

.hidden-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 400px;
  height: 560px;
  pointer-events: none;
}
