<!-- 心愿证书 -->
<view class="page wing-page cert-page">
  <view class="wing-head" style="padding-top: {{statusBarHeight}}px;">
    <text class="wing-title">证 书</text>
  </view>

  <scroll-view class="wing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wing-body">
      <block wx:if="{{hasCert && cert}}">
        <view class="congrats">
          <text class="cong-title">心愿已成</text>
          <text class="cong-sub">{{cert.name}}</text>
        </view>
        <view class="cert-list" wx:if="{{certs.length > 1}}">
          <text
            wx:for="{{certs}}"
            wx:key="_id"
            class="cert-name {{cert._id === item._id ? 'on' : ''}}"
            hover-class="hover-dim"
            data-id="{{item._id}}"
            bindtap="pickCert"
          >{{item.name}}</text>
        </view>

        <view class="paper-frame">
          <view class="paper-placeholder" wx:if="{{!certPath}}"></view>
          <image wx:else class="paper-img" src="{{certPath}}" mode="widthFix"></image>
        </view>

        <view class="actions">
          <text class="act" hover-class="hover-dim" bindtap="saveAlbum">保存相册</text>
          <text class="act" hover-class="hover-dim" bindtap="shareCert">转发</text>
        </view>
        <text class="tip">长按亦可截取</text>
      </block>

      <block wx:else>
        <view class="empty" wx:if="{{!loading}}">
          <text class="empty-title">待心愿完成</text>
          <text class="empty-sub">专注既满，证书自现</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <canvas type="2d" id="certCanvas" class="hidden-canvas"></canvas>
  <hall-dock mode="wing" current="{{2}}" />
</view>
