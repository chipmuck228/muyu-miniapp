<!-- 渠道合作：申请 / 记录 / 推广 -->
<view class="page wing-page partner-page">
  <view class="wing-head has-kicker" style="padding-top: {{statusBarHeight}}px;">
    <view class="wing-kicker" hover-class="hover-dim" bindtap="goHall">回堂</view>
    <text class="wing-title">合 作</text>
    <text class="wing-kicker ghost"></text>
  </view>
  <scroll-view
    class="wing-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-background="#0a0806"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="wing-body" wx:if="{{ready}}">
      <view class="block first" wx:if="{{needActivate}}">
        <text class="block-label">待激活</text>
        <text class="ch-name" wx:if="{{activateName}}">{{activateName}}</text>
        <image wx:if="{{activateQrSrc}}" class="qr" src="{{activateQrSrc}}" mode="aspectFit" show-menu-by-longpress />
        <text class="qr-hint" wx:if="{{activateCode}}">{{activateCode}}</text>
        <text class="qr-hint" wx:if="{{activateExpireText}}">{{activateExpireText}}</text>
        <text class="hint" wx:if="{{activateExpired}}">激活码已过期，请联系管理员重发</text>
        <view wx:elif="{{!activateExpired}}" class="submit" hover-class="hover-dim" bindtap="doActivate">激 活</view>
      </view>
      <view class="block first" wx:elif="{{canApplyBind}}">
        <text class="block-label">渠道商申请</text>
        <text class="label">名称</text>
        <input
          class="input"
          maxlength="20"
          placeholder="管理员用于辨认的名称"
          placeholder-class="ph"
          adjust-position="{{false}}"
          hold-keyboard
          bindinput="onName"
        />
        <text class="label">联系</text>
        <input
          class="input"
          maxlength="40"
          placeholder="选填"
          placeholder-class="ph"
          adjust-position="{{false}}"
          hold-keyboard
          bindinput="onContact"
        />
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="佣金结算与联系使用"
          placeholder-class="ph"
          value="{{phone}}"
          adjust-position="{{false}}"
          hold-keyboard
          bindinput="onPhone"
        />
        <text class="hint">申请渠道合作需提供真实手机号，仅用于佣金结算与联系，不会在推广列表中展示。提交后可在下方自助修改。</text>

        <view class="agree">
          <view class="agree-head" hover-class="hover-dim" bindtap="toggleAgree">
            <text class="agree-title">渠道商须知（佣金 / 结算 / 解绑）</text>
            <text class="agree-arrow">{{agreeOpen ? '收起' : '展开'}}</text>
          </view>
          <scroll-view scroll-y class="agree-body" wx:if="{{agreeOpen}}">
            <text class="agree-line">一、佣金计算：佣金 = 用户实付金额 × 渠道费率。费率由管理员设置（最高 30%），按笔记录；订单发生退款时，对应佣金一并冲销，不计入结算。</text>
            <text class="agree-line">二、结算日期：佣金按自然月归集，次月由管理员核对后统一结算。当月数据要等次月才能结算，小程序内的「结算」只标记状态，不会自动打款，打款由管理员线下完成。</text>
            <text class="agree-line">三、解绑后的佣金：解绑生效后，名下用户的后续付款不再计入你的佣金；解绑前已产生的佣金仍按正常流程结算，不受解绑影响。解绑后用户归属不变，但无法转投其他渠道商名下。</text>
            <text class="agree-line">四、联系与结算义务：需提供真实有效的手机号用于结算联系，号码变更应及时在本页自助更新；因号码错误导致无法打款的，由渠道商自行承担。</text>
            <text class="agree-line">五、税务：佣金为含税金额，平台不代扣代缴。渠道商应自行就佣金收入申报并缴纳个人所得税等相关税费，因未依法申报纳税产生的责任由渠道商自行承担。</text>
            <text class="agree-line">六、你的权利：可随时查看推广用户、当月新增与结算状态，可自助修改结算手机号；对结算金额有异议可向管理员提出核对。</text>
          </scroll-view>
          <view class="agree-check" hover-class="hover-dim" bindtap="toggleAgreeCheck">
            <view class="agree-box {{agreeChecked ? 'on' : ''}}">{{agreeChecked ? '✓' : ''}}</view>
            <text class="agree-check-text">我已阅读并同意以上须知</text>
          </view>
        </view>

        <view class="submit" hover-class="hover-dim" bindtap="doApply">提交申请</view>
      </view>
      <view class="hint pending-row" wx:elif="{{pendingBind}}">
        <text>绑定申请已提交，等待管理员授权</text>
        <text class="phone-edit" hover-class="hover-dim" bindtap="editPhone">修改手机号</text>
      </view>

      <view class="block">
        <text class="block-label">我的推广</text>
        <text class="empty" wx:if="{{!tenures.length}}">暂无推广</text>
        <view
          class="row {{item.on ? 'on' : ''}}"
          wx:for="{{tenures}}"
          wx:key="key"
          data-id="{{item.channelId}}"
          bindtap="pickTenure"
        >
          <view class="row-main">
            <text class="row-name">{{item.name}}</text>
            <text class="row-st">{{item.timeText}}</text>
          </view>
        </view>
        <view class="phone-row" wx:if="{{isActive}}">
          <text class="phone-text">{{phone ? '结算联系 ' + phone : '未填写结算手机号'}}</text>
          <text class="phone-edit" hover-class="hover-dim" bindtap="editPhone">{{phone ? '修改' : '填写'}}</text>
        </view>
      </view>

      <view class="block">
        <text class="block-label">申请记录</text>
        <text class="empty" wx:if="{{!applications.length}}">暂无记录</text>
        <view class="row" wx:for="{{applications}}" wx:key="_id">
          <view class="row-main">
            <text class="row-name">{{item.title}}</text>
            <text class="row-status">{{item.statusText}}</text>
            <text class="row-st" wx:if="{{item.phone}}">联系 {{item.phone}}</text>
            <text class="row-st" wx:if="{{item.timeText}}">{{item.timeText}}</text>
            <text class="row-st" wx:if="{{item.extraText}}">{{item.extraText}}</text>
          </view>
          <text class="row-act inline" wx:if="{{item.canUnbind}}" hover-class="hover-dim" catchtap="applyUnbind">申请解绑</text>
        </view>
        <text class="hint" wx:if="{{pendingUnbind}}">解绑申请已提交，等待管理员处理</text>
      </view>

      <view wx:if="{{selectedId}}">
        <text class="ch-name">{{name}}</text>
        <view class="stats-row">
          <view class="stat">
            <text class="st-num">{{userCount}}</text>
            <text class="st-label">用户</text>
          </view>
          <view class="stat">
            <text class="st-num">{{paidCount}}</text>
            <text class="st-label">付费</text>
          </view>
          <view class="stat">
            <text class="st-num">{{totalText}}</text>
            <text class="st-label">佣金</text>
          </view>
          <view class="stat">
            <text class="st-num">{{pendingText}}</text>
            <text class="st-label">待结</text>
          </view>
        </view>

        <view class="settle-head" wx:if="{{monthValue}}">
          <text class="settle-sum">{{monthValue}} 新增 {{calTotal}} 人</text>
          <text class="settle-tag {{settlementStatus === 'settled' ? 'on' : ''}}">{{settlementStatus === 'settled' ? '已结算' : '未结算'}}</text>
        </view>
        <text class="settle-time" wx:if="{{settledText}}">结算于 {{settledText}}</text>

        <view class="cal" wx:if="{{monthValue}}">
          <view class="cal-week">
            <text class="cal-w" wx:for="{{weekNames}}" wx:key="*this">{{item}}</text>
          </view>
          <view class="cal-grid">
            <view
              class="cal-cell {{item.empty ? 'is-empty' : ''}} {{item.count ? 'has' : ''}}"
              wx:for="{{calCells}}"
              wx:key="key"
            >
              <text class="cal-d" wx:if="{{!item.empty}}">{{item.day}}</text>
              <text class="cal-n" wx:if="{{!item.empty && item.count}}">{{item.count}}</text>
            </view>
          </view>
        </view>

        <text class="hint" wx:if="{{truncated}}">该月佣金记录超过 1000 条，统计可能偏少，请联系管理员核对</text>

        <view class="block" wx:if="{{isActive}}">
          <text class="block-label">我的推广码</text>
          <image wx:if="{{qrSrc}}" class="qr" src="{{qrSrc}}" mode="aspectFit" show-menu-by-longpress />
          <text class="qr-hint" wx:if="{{qrSrc}}">长按可保存</text>
        </view>

        <view class="block">
          <text class="block-label">推广用户</text>
          <view class="search">
            <input
              class="input"
              maxlength="40"
              placeholder="按识别号搜索"
              placeholder-class="ph"
              value="{{userQuery}}"
              adjust-position="{{false}}"
              hold-keyboard
              bindinput="onUserQ"
              bindconfirm="searchUsers"
            />
            <text class="search-btn" hover-class="hover-dim" bindtap="searchUsers">搜索</text>
          </view>
          <picker mode="selector" range="{{months}}" range-key="label" value="{{monthIndex}}" bindchange="onMonth">
            <text class="filter">{{months[monthIndex].label}}</text>
          </picker>
          <text class="empty" wx:if="{{!users.length}}">暂无用户</text>
          <view class="user-row" wx:for="{{users}}" wx:key="id">
            <view class="user-main">
              <text class="user-nick">{{item.wechatId}}</text>
              <text class="user-sub">{{item.timeText}}</text>
            </view>
            <text class="user-pay">{{item.paidText}}</text>
          </view>
          <text class="hint" wx:if="{{usersTruncated}}">推广用户超过 1000 人，这里只显示最近绑定的 1000 人</text>
          <text class="user-note">用户仅以识别号标识，不采集头像与昵称</text>
        </view>

        <view class="block">
          <text class="block-label">结算说明</text>
          <text class="note-line">佣金按自然月结算，次月由管理员核对后统一打款。结算通过手机号转账（支付宝 / 微信零钱）完成，请确保上方手机号可正常收款，号码变更后请及时修改。</text>
          <text class="note-line">佣金金额为含税金额，平台不代扣代缴；相关税费由渠道商自行申报缴纳。</text>
          <text class="note-line">小程序内点「结算」只记录结算状态，不会自动扣款或打款。</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
