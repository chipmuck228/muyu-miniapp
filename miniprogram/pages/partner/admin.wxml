<!-- 渠道管理：申请授权 / 解绑 -->
<view class="page wing-page partner-page">
  <view class="wing-head has-kicker" style="padding-top: {{statusBarHeight}}px;">
    <view class="wing-kicker" hover-class="hover-dim" bindtap="goHall">回堂</view>
    <text class="wing-title">管 理</text>
    <text class="wing-kicker ghost"></text>
  </view>
  <scroll-view
    class="wing-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-background="#0a0806"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="wing-body" wx:if="{{ready}}">
      <view class="block first">
        <text class="block-label">绑定申请</text>
        <text class="empty" wx:if="{{!bindApps.length}}">暂无申请</text>
        <view class="row" wx:for="{{bindApps}}" wx:key="_id">
          <view class="row-main">
            <text class="row-name">{{item.name}}</text>
            <text class="row-st">{{item.line}}</text>
          </view>
          <text class="row-act" hover-class="hover-dim" data-id="{{item._id}}" bindtap="authorize">授权</text>
          <text class="row-act dim" hover-class="hover-dim" data-id="{{item._id}}" bindtap="reject">驳回</text>
        </view>
      </view>

      <image wx:if="{{qrSrc}}" class="qr" src="{{qrSrc}}" mode="aspectFit" show-menu-by-longpress />
      <text class="qr-cap" wx:if="{{qrSrc}}">{{qrTitle}} · {{qrCode}}</text>
      <text class="hint" wx:if="{{qrSrc && qrExpire}}">{{qrExpire}}</text>
      <text class="hint" wx:if="{{qrSrc}}">仅申请人可在有效期内激活</text>

      <view class="block">
        <text class="block-label">解绑申请</text>
        <text class="empty" wx:if="{{!unbindApps.length}}">暂无申请</text>
        <view class="row" wx:for="{{unbindApps}}" wx:key="_id">
          <view class="row-main">
            <text class="row-name">{{item.name}}</text>
            <text class="row-st">{{item.line}}</text>
          </view>
          <text
            class="row-act"
            hover-class="hover-dim"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bindtap="approveUnbind"
          >解绑</text>
          <text class="row-act dim" hover-class="hover-dim" data-id="{{item._id}}" bindtap="reject">驳回</text>
        </view>
      </view>

      <view class="block" wx:if="{{list.length}}">
        <text class="block-label">渠道</text>
        <view class="row" wx:for="{{list}}" wx:key="_id">
          <view class="row-main">
            <text class="row-name">{{item.name}}</text>
            <text class="row-st">{{item.statusText}}</text>
          </view>
          <text
            wx:if="{{item.pending}}"
            class="row-act"
            hover-class="hover-dim"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bindtap="viewQr"
          >查看</text>
          <text
            wx:if="{{item.pending}}"
            class="row-act"
            hover-class="hover-dim"
            data-id="{{item._id}}"
            bindtap="refreshActivate"
          >重发</text>
          <text
            wx:if="{{item.canUnbind}}"
            class="row-act"
            hover-class="hover-dim"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bindtap="unbind"
          >解绑</text>
        </view>
      </view>

      <view class="block">
        <text class="block-label">佣金结算</text>
        <view class="settle-bar">
          <picker mode="selector" range="{{settleMonths}}" range-key="label" value="{{settleMonthIndex}}" bindchange="onSettleMonth">
            <text class="filter">{{settleMonths[settleMonthIndex].label}}</text>
          </picker>
          <text class="settle-total">待结 ¥{{settleTotalText}}</text>
        </view>
        <text class="empty" wx:if="{{!settleList.length}}">该月暂无渠道数据</text>
        <view class="row" wx:for="{{settleList}}" wx:key="channelId">
          <view class="row-main">
            <text class="row-name">{{item.name}}</text>
            <text class="row-st">新增 {{item.userCount}} · 付费 {{item.paidCount}} · 佣金 ¥{{item.commissionText}}</text>
            <text class="row-st" wx:if="{{item.phone}}">手机 {{item.phone}}</text>
            <text class="row-st" wx:if="{{item.refundedAmount}}">其中已退款 ¥{{item.refundText}}</text>
            <text class="row-st" wx:if="{{item.settledText}}">结算于 {{item.settledText}}</text>
          </view>
          <text
            wx:if="{{item.status !== 'settled'}}"
            class="row-act"
            hover-class="hover-dim"
            data-id="{{item.channelId}}"
            bindtap="doSettle"
          >结算</text>
          <text wx:else class="row-act dim">已结算</text>
        </view>
        <text class="user-note">结算只记录状态，不触发转账；请按手机号线下完成打款。佣金为含税金额，平台不代扣代缴。</text>
      </view>

      <text class="wipe" hover-class="hover-dim" bindtap="wipe">清空记录</text>
    </view>
  </scroll-view>
</view>
