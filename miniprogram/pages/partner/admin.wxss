.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.32);
}
.qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 48rpx auto 0;
}
.qr-cap {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(232, 201, 138, 0.7);
}
.block {
  margin-top: 56rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.block.first {
  margin-top: 8rpx;
  padding-top: 0;
  border-top: 0;
}
.empty {
  display: block;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.28);
}
.row-act.dim {
  color: rgba(240, 230, 216, 0.32);
}
.block-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.row-name {
  font-size: 30rpx;
  color: rgba(240, 230, 216, 0.72);
}
.row-st {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.32);
}
.row-act {
  margin-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.wipe {
  display: block;
  margin-top: 80rpx;
  padding-bottom: 24rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 8rpx;
  color: rgba(240, 230, 216, 0.16);
}
