.ch-name {
  display: block;
  margin-top: 36rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: rgba(232, 201, 138, 0.8);
}
.stats-row {
  display: flex;
  margin-top: 36rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.st-num {
  font-size: 34rpx;
  color: #e8c98a;
}
.st-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(240, 230, 216, 0.35);
}
.qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 12rpx auto 0;
}
.qr-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.32);
}
.block {
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.block.first {
  margin-top: 8rpx;
  padding-top: 0;
  border-top: 0;
}
.block-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.row-txt {
  display: block;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.5);
}
.pay-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}
.pay-title {
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.5);
}
.pay-amt {
  font-size: 28rpx;
  color: rgba(224, 181, 119, 0.7);
}
.label {
  display: block;
  margin-top: 36rpx;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.input {
  width: 100%;
  height: 72rpx;
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #f0e6d8;
  background: transparent;
}
.ph {
  color: rgba(240, 230, 216, 0.22);
}
.submit {
  margin-top: 40rpx;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 16rpx;
  padding: 16rpx 0;
  color: #e8c98a;
}
.hint {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.38);
}
.empty {
  display: block;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.28);
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.row.on .row-name {
  color: #e8c98a;
}
.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.row-name {
  font-size: 30rpx;
  color: rgba(240, 230, 216, 0.72);
}
.row-st {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.32);
}
.row-act {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.row-act.lone {
  display: block;
  padding: 8rpx 0;
}
.search {
  display: flex;
  align-items: center;
}
.search .input {
  flex: 1;
  min-width: 0;
  width: auto;
}
.search-btn {
  margin-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.filter {
  display: block;
  margin: 16rpx 0 8rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(232, 201, 138, 0.7);
}
.user-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.user-nick {
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(240, 230, 216, 0.32);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-pay {
  margin-left: 16rpx;
  flex: none;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.7);
}
.user-note {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(240, 230, 216, 0.28);
}

/* 结算联系手机号 */
.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(240, 230, 216, 0.08);
}
.phone-text {
  font-size: 24rpx;
  color: rgba(240, 230, 216, 0.5);
}
.phone-edit {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
}

/* 当月结算状态 */
.settle-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}
.settle-sum {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.7);
}
.settle-tag {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.45);
  border: 1rpx solid rgba(240, 230, 216, 0.16);
}
.settle-tag.on {
  color: #1a1510;
  background: #e8c98a;
  border-color: #e8c98a;
}
.settle-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(240, 230, 216, 0.3);
}

/* 当月新增日历 */
.cal {
  margin-top: 18rpx;
  padding: 16rpx 12rpx 12rpx;
  border: 1rpx solid rgba(224, 181, 119, 0.12);
  border-radius: 16rpx;
  background: rgba(224, 181, 119, 0.03);
}
.cal-week {
  display: flex;
}
.cal-w {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(232, 201, 138, 0.5);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.cal-cell {
  width: 14.2857%;
  height: 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cal-d {
  font-size: 20rpx;
  color: rgba(240, 230, 216, 0.4);
}
.cal-cell.has {
  border-radius: 10rpx;
  background: rgba(224, 181, 119, 0.16);
}
.cal-cell.has .cal-d {
  color: rgba(240, 230, 216, 0.85);
}
.cal-n {
  margin-top: 1rpx;
  font-size: 18rpx;
  color: #e8c98a;
}
.cal-cell.is-empty {
  visibility: hidden;
}

/* 结算说明 */
.note-line {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(240, 230, 216, 0.34);
}

.pending-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 渠道商须知 */
.agree {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(224, 181, 119, 0.18);
  border-radius: 16rpx;
  background: rgba(224, 181, 119, 0.04);
}
.agree-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.agree-title {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
}
.agree-arrow {
  flex: none;
  font-size: 24rpx;
  color: rgba(240, 230, 216, 0.45);
}
.agree-body {
  max-height: 460rpx;
  margin-top: 16rpx;
  padding-right: 6rpx;
}
.agree-line {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(240, 230, 216, 0.55);
}
.agree-check {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}
.agree-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(240, 230, 216, 0.3);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1a1510;
}
.agree-box.on {
  background: #e8c98a;
  border-color: #e8c98a;
}
.agree-check-text {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 216, 0.7);
}

.row-status {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 201, 138, 0.85);
}
.row-act.inline {
  flex: none;
  margin-left: 24rpx;
}
