.ch-name {
  display: block;
  margin-top: 36rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: rgba(232, 201, 138, 0.8);
}
.stats-row {
  display: flex;
  margin-top: 36rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.st-num {
  font-size: 34rpx;
  color: #e8c98a;
}
.st-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(240, 230, 216, 0.35);
}
.qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 12rpx auto 0;
}
.qr-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.32);
}
.block {
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(224, 181, 119, 0.08);
}
.block.first {
  margin-top: 8rpx;
  padding-top: 0;
  border-top: 0;
}
.block-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.row-txt {
  display: block;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.5);
}
.pay-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}
.pay-title {
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.5);
}
.pay-amt {
  font-size: 28rpx;
  color: rgba(224, 181, 119, 0.7);
}
.label {
  display: block;
  margin-top: 36rpx;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.input {
  width: 100%;
  height: 72rpx;
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #f0e6d8;
  background: transparent;
}
.ph {
  color: rgba(240, 230, 216, 0.22);
}
.submit {
  margin-top: 40rpx;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 16rpx;
  padding: 16rpx 0;
  color: #e8c98a;
}
.hint {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.38);
}
.empty {
  display: block;
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 230, 216, 0.28);
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.row.on .row-name {
  color: #e8c98a;
}
.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.row-name {
  font-size: 30rpx;
  color: rgba(240, 230, 216, 0.72);
}
.row-st {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.32);
}
.row-act {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.row-act.lone {
  display: block;
  padding: 8rpx 0;
}
.search {
  display: flex;
  align-items: center;
}
.search .input {
  flex: 1;
  min-width: 0;
  width: auto;
}
.search-btn {
  margin-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.filter {
  display: block;
  margin: 16rpx 0 8rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(232, 201, 138, 0.7);
}
.user-row {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
}
.user-id {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.62);
}
.user-meta {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 216, 0.32);
}
.user-pay {
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.7);
}
