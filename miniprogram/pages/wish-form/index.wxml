<!-- 立 / 改心愿 -->
<view class="page wing-page form-page">
  <view class="wing-head has-kicker" style="padding-top: {{statusBarHeight}}px;">
    <text class="wing-kicker" hover-class="hover-dim" bindtap="doCancel">回堂</text>
    <text class="wing-title">{{isEdit ? '改 愿' : '立 愿'}}</text>
    <text class="wing-kicker ghost"></text>
  </view>

  <scroll-view class="wing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wing-body">
      <view class="field">
        <text class="field-label">心愿</text>
        <input
          class="field-input"
          value="{{name}}"
          placeholder="默念所求，最多二十字"
          placeholder-class="ph"
          maxlength="20"
          bindinput="onNameInput"
        />
      </view>

      <view class="field">
        <text class="field-label">功德</text>
        <view class="goal-grid">
          <view
            wx:for="{{goalOptions}}"
            wx:key="value"
            class="goal-opt {{selectedGoal === item.value ? 'on' : ''}}"
            data-value="{{item.value}}"
            bindtap="onPickPreset"
          >{{item.label}}</view>
        </view>
        <input
          class="field-input"
          type="digit"
          value="{{customGoal}}"
          placeholder="或自定其数"
          placeholder-class="ph"
          bindinput="onCustomInput"
        />
      </view>

      <view class="field">
        <text class="field-label">期限</text>
        <picker mode="date" value="{{deadline}}" start="{{minDate}}" bindchange="onPickDeadline">
          <view class="deadline-row">
            <text class="dl-text {{deadline ? '' : 'ph'}}">{{deadline || '未设期限'}}</text>
            <text class="dl-clear" wx:if="{{deadline}}" catchtap="clearDeadline">清除</text>
          </view>
        </picker>
      </view>

      <view
        class="submit {{submitting ? 'off' : ''}}"
        hover-class="hover-dim"
        bindtap="doSubmit"
      >{{isEdit ? '保存' : '立下心愿'}}</view>
    </view>
  </scroll-view>

  <hall-dock mode="wing" current="{{2}}" />
</view>
