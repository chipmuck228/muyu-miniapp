.field {
  padding: 28rpx 0 8rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.12);
}
.field-label {
  display: block;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.5);
}
.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0;
  font-size: 34rpx;
  color: #f0e6d8;
  background: transparent;
  box-sizing: border-box;
}
.ph {
  color: rgba(240, 230, 216, 0.22);
}

.goal-grid {
  margin: 18rpx 0 4rpx;
  display: flex;
  flex-wrap: wrap;
  margin-left: -16rpx;
}
.goal-opt {
  margin: 0 0 12rpx 16rpx;
  padding: 10rpx 0;
  width: calc((100% - 48rpx) / 3);
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 230, 216, 0.45);
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.14);
  box-sizing: border-box;
}
.goal-opt.on {
  color: #e8c98a;
  border-bottom-color: rgba(232, 201, 138, 0.7);
}

.deadline-row {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dl-text {
  font-size: 34rpx;
  color: #f0e6d8;
}
.dl-clear {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.55);
}

.form-hint {
  display: block;
  margin-top: 64rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.38);
}
.form-hint + .submit {
  margin-top: 16rpx;
}
.submit {
  margin-top: 80rpx;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 16rpx;
  padding: 24rpx 0 24rpx 16rpx;
  color: #e8c98a;
}
.submit.off {
  opacity: 0.35;
  pointer-events: none;
}
