.form-body {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.field {
  padding: 32rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.1);
}
.field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.field-label {
  display: block;
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(224, 181, 119, 0.6);
}
.field-count {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.3);
  font-variant-numeric: tabular-nums;
}
.field-count.full {
  color: rgba(240, 150, 120, 0.85);
}
.field-input {
  width: 100%;
  height: 80rpx;
  padding: 0;
  font-size: 36rpx;
  color: #f3eadc;
  background: transparent;
  box-sizing: border-box;
}
.name-input {
  margin-top: 8rpx;
  font-family: var(--serif);
  letter-spacing: 4rpx;
}
.ph {
  color: rgba(240, 230, 216, 0.22);
}

/* 心愿灵感、期限快捷：一排小签 */
.ideas,
.due-quick {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0 0 -8rpx;
}
.idea {
  margin: 8rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.55);
  border: 1rpx solid rgba(224, 181, 119, 0.2);
}
.idea.on {
  color: #1b130c;
  background: rgba(232, 201, 138, 0.85);
  border-color: transparent;
}
.idea-hover {
  background: rgba(224, 181, 119, 0.14);
}

/* 专注目标：三列小格，最后一格可自己填 */
.goal-grid {
  margin: 20rpx 0 0 -16rpx;
  display: flex;
  flex-wrap: wrap;
}
.goal-opt {
  margin: 0 0 16rpx 16rpx;
  width: calc((100% - 48rpx) / 3);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  color: rgba(243, 234, 220, 0.6);
  border-radius: 16rpx;
  background: rgba(255, 236, 200, 0.03);
  border: 1rpx solid rgba(224, 181, 119, 0.16);
  box-sizing: border-box;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.goal-opt.on {
  color: #e8c98a;
  background: rgba(224, 181, 119, 0.12);
  border-color: rgba(232, 201, 138, 0.7);
  box-shadow: 0 0 20rpx rgba(232, 201, 138, 0.12);
}
.goal-hover {
  background: rgba(224, 181, 119, 0.1);
}
.custom-input {
  width: 100%;
  height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #e8c98a;
}
.estimate {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 201, 138, 0.6);
}

.deadline-row {
  height: 80rpx;
  display: flex;
  align-items: center;
}
.dl-text {
  font-size: 34rpx;
  color: #f3eadc;
}
.dl-due {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: rgba(232, 201, 138, 0.85);
  background: rgba(224, 181, 119, 0.1);
}
.dl-clear {
  margin-left: auto;
  padding: 12rpx 0 12rpx 24rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.55);
}

.form-hint {
  display: block;
  margin-top: 64rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.42);
}
.form-hint + .submit {
  margin-top: 20rpx;
}
.submit {
  margin-top: 72rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 34rpx;
  letter-spacing: 16rpx;
  padding-left: 16rpx;
  color: #1b130c;
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  box-shadow: 0 14rpx 36rpx rgba(224, 181, 119, 0.24);
  transition: opacity 0.2s ease, box-shadow 0.2s ease;
}
.submit.idle {
  opacity: 0.4;
  box-shadow: none;
}
.submit-hover {
  opacity: 0.85;
}
.submit.off {
  opacity: 0.35;
  pointer-events: none;
}
.remove {
  display: block;
  margin-top: 48rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(214, 110, 90, 0.75);
}
