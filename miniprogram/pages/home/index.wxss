.home-page {
  position: relative;
  background: #0a0806;
  overflow: hidden;
}
.home-page.theme-night {
  background: #07090e;
}
.home-page.theme-ink {
  background: #0c0c0c;
}
.home-page.theme-dusk {
  background: #120c09;
}
.theme-night .dawn-paper {
  filter: brightness(0.42) saturate(0.55) hue-rotate(200deg);
}
.theme-ink .dawn-paper {
  filter: grayscale(1) brightness(0.5) contrast(1.08);
}
.theme-dusk .dawn-paper {
  filter: sepia(0.45) saturate(1.35) brightness(0.62) hue-rotate(-12deg);
}
.theme-night .knock-pad {
  background: radial-gradient(circle, rgba(150, 186, 214, 0.07) 0%, rgba(150, 186, 214, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(168, 196, 220, 0.22);
}
.theme-ink .knock-pad {
  background: radial-gradient(circle, rgba(220, 220, 216, 0.05) 0%, rgba(220, 220, 216, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(220, 220, 216, 0.18);
}
.theme-dusk .knock-pad {
  background: radial-gradient(circle, rgba(232, 150, 96, 0.08) 0%, rgba(232, 150, 96, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(232, 150, 96, 0.28);
}
.theme-night .ripple-ring {
  border-color: rgba(186, 214, 232, 0.88);
}
.theme-ink .ripple-ring {
  border-color: rgba(232, 232, 228, 0.75);
}
.theme-dusk .ripple-ring {
  border-color: rgba(240, 168, 112, 0.9);
}
.theme-night .float-text.score { color: #d5e6f4; }
.theme-night .float-text.chant { color: #b7c9dc; }
.theme-ink .float-text.score { color: #e6e4de; }
.theme-ink .float-text.chant { color: #bdb9b0; }
.theme-dusk .float-text.score { color: #ffc49a; }
.theme-dusk .float-text.chant { color: #f0d2bc; }

.enter-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(8, 6, 4, 0.86);
  pointer-events: auto;
}

.phase-reveal .enter-veil {
  animation: veil-out 0.48s ease forwards;
}

@keyframes veil-out {
  to { opacity: 0; }
}

.phase-cover .enter-altar {
  opacity: 0;
}
.phase-reveal .enter-altar {
  animation: altar-in 0.56s ease 0.12s both;
}
.phase-done .enter-altar {
  opacity: 1;
}
@keyframes altar-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.home-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

.dawn {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.dawn-paper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  transition: opacity 0.42s ease;
}
.smoke-gl-fill {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: block;
  overflow: hidden;
  pointer-events: none;
  transition: opacity 0.42s ease;
}

.void-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.void-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.void-fallback .ember {
  position: absolute;
  left: 50%;
  top: 72%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-top: -9rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ff5c2a 0%, rgba(120, 20, 0, 0) 70%);
  animation: ember-breathe 3.6s ease-in-out infinite;
}
.void-fallback .puff {
  position: absolute;
  left: 50%;
  top: 72%;
  width: 4rpx;
  height: 4rpx;
  margin-left: -2rpx;
  border-radius: 50%;
  background: rgba(196, 222, 226, 0.62);
  animation: puff-rise 9.2s linear infinite;
}
.void-fallback .puff.p0 { animation-delay: 0s; }
.void-fallback .puff.p1 { animation-delay: 1.1s; }
.void-fallback .puff.p2 { animation-delay: 2.2s; }
.void-fallback .puff.p3 { animation-delay: 3.3s; }
.void-fallback .puff.p4 { animation-delay: 4.4s; }
.void-fallback .puff.p5 { animation-delay: 5.5s; }
.void-fallback .puff.p6 { animation-delay: 6.6s; }
.void-fallback .puff.p7 { animation-delay: 7.7s; }
@keyframes ember-breathe {
  0%, 100% { opacity: 0.65; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.18); }
}
@keyframes puff-rise {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 0.7;
    filter: blur(0);
  }
  62% {
    transform: translate3d(2rpx, -38vh, 0) scale(1.8);
    opacity: 0.4;
    filter: blur(1rpx);
  }
  68% {
    transform: translate3d(4rpx, -40vh, 0) scale(2);
    opacity: 0.36;
    filter: blur(2rpx);
  }
  100% {
    transform: translate3d(72rpx, -52vh, 0) scale(6);
    opacity: 0;
    filter: blur(8rpx);
  }
}

.smoke-rev {
  position: absolute;
  left: 16rpx;
  z-index: 6;
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: rgba(224, 181, 119, 0.38);
  pointer-events: none;
}
.lesson-title {
  position: absolute;
  left: 50%;
  top: 18%;
  z-index: 6;
  width: 88rpx;
  height: 56%;
  margin-left: -44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}
.lesson-title.on {
  animation: lesson-in 1.6s ease forwards;
}
@keyframes lesson-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.lesson-ch {
  display: block;
  font-size: 34rpx;
  line-height: 1.45;
  text-align: center;
  color: #ffffff;
  transition: color 0.35s ease;
}
.lesson-title-canvas {
  position: absolute;
  left: 50%;
  top: 18%;
  z-index: 7;
  width: 88rpx;
  height: 56%;
  margin-left: -44rpx;
  pointer-events: none;
}

.altar-fill {
  flex: 1;
  min-height: 0;
  pointer-events: none;
}

.knock-wrap {
  position: relative;
  flex-shrink: 0;
  height: 320rpx;
  z-index: 3;
}

.knock-pad {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  z-index: 3;
  width: 280rpx;
  height: 280rpx;
  margin-left: -140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 181, 119, 0.06) 0%, rgba(224, 181, 119, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(224, 181, 119, 0.16);
}

.knock-hover {
  opacity: 0.85;
}

.knock-pad.pulsing {
  animation: knock-bounce 0.22s ease-out;
}

@keyframes knock-bounce {
  0% { transform: scale(0.92); }
  45% { transform: scale(0.965); }
  70% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

.ripple-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 4;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  margin-top: -80rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 214, 140, 0.9);
  opacity: 0;
  pointer-events: none;
}
.ripple-ring.on {
  animation: ripple 0.7s ease-out;
}
@keyframes ripple {
  0% {
    opacity: 0.9;
    transform: scale(0.4);
  }
  100% {
    opacity: 0;
    transform: scale(2.8);
  }
}

.floats-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 5;
}
.float-text {
  position: absolute;
  bottom: 40%;
  font-size: 38rpx;
  font-weight: 700;
  white-space: nowrap;
  opacity: 0;
  animation: float-up 1s ease-out forwards;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.6);
}
.float-text.score {
  color: #ffd98a;
}
.float-text.chant {
  color: #b7e8c8;
}
.float-text.celebrate {
  color: #ff9d76;
  font-size: 44rpx;
}
@keyframes float-up {
  0% {
    opacity: 0;
    transform: translate(-50%, 10rpx) scale(0.6);
  }
  18% {
    opacity: 1;
    transform: translate(-50%, -30rpx) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -220rpx) scale(1);
  }
}

/* 顶部当前功课：轻触打开今日功课切换 */
.lesson-head {
  position: absolute;
  left: 40rpx;
  z-index: 8;
  max-width: 60%;
  padding: 8rpx 12rpx 12rpx 0;
}
.lesson-head-hover {
  opacity: 0.7;
}
.lh-row {
  display: flex;
  align-items: baseline;
}
.lh-name {
  min-width: 0;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lh-switch {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.lh-count {
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}
.lh-cur {
  font-size: 44rpx;
  color: #e8c98a;
}
.lh-goal {
  font-size: 28rpx;
  color: rgba(224, 181, 119, 0.55);
}
.lh-bar {
  margin-top: 12rpx;
  width: 320rpx;
  height: 4rpx;
  background: rgba(224, 181, 119, 0.16);
}
.lh-fill {
  height: 100%;
  background: #e0b577;
  transition: width 0.15s ease;
}

/* 心愿圆满弹窗 */
.celebrate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 6, 4, 0.78);
  animation: cel-fade 0.4s ease both;
}
.celebrate-card {
  width: 600rpx;
  padding: 64rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #16110d;
  border: 1rpx solid rgba(224, 181, 119, 0.28);
  animation: cel-rise 0.5s ease both;
}
.cel-kicker {
  font-size: 28rpx;
  letter-spacing: 12rpx;
  padding-left: 12rpx;
  color: rgba(224, 181, 119, 0.7);
}
.cel-name {
  margin-top: 24rpx;
  max-width: 100%;
  font-size: 44rpx;
  letter-spacing: 6rpx;
  color: #f3eadc;
  text-align: center;
}
.cel-goal {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.cel-thumb {
  margin-top: 40rpx;
  width: 360rpx;
  height: 480rpx;
}
.cel-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.cel-actions {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  gap: 24rpx;
}
.cel-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #e8c98a;
  border: 1rpx solid rgba(224, 181, 119, 0.45);
}
.cel-btn.primary {
  background: #e0b577;
  border-color: #e0b577;
  color: #16110d;
}
.cel-hover {
  opacity: 0.75;
}
@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cel-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: none; }
}

/* 圆满后切换功课：弹窗里预告下一个，关掉后顶部再提示一次 */
.cel-next {
  margin-top: 40rpx;
  max-width: 100%;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.7);
  text-align: center;
}
.cel-next + .cel-actions {
  margin-top: 24rpx;
}
.lh-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
  animation: lh-hint 2.6s ease both;
}
@keyframes lh-hint {
  0% { opacity: 0; transform: translateY(-8rpx); }
  12%, 80% { opacity: 1; transform: none; }
  100% { opacity: 0; }
}
.lesson-head.switched .lh-name {
  animation: lh-glow 1.4s ease 2;
}
@keyframes lh-glow {
  0%, 100% { color: rgba(243, 234, 220, 0.88); }
  50% { color: #ffd98a; text-shadow: 0 0 16rpx rgba(255, 217, 138, 0.55); }
}

/* 3D 木鱼：舞台在敲击热区正下方，热区透明盖在上面接收点击 */
.knock-wrap {
  height: 480rpx;
}
.muyu-stage {
  position: absolute;
  left: 50%;
  bottom: 0;
  z-index: 2;
  width: 520rpx;
  height: 480rpx;
  margin-left: -260rpx;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.muyu-gl {
  display: block;
  width: 100%;
  height: 100%;
}
.knock-pad {
  bottom: 40rpx;
  width: 400rpx;
  height: 400rpx;
  margin-left: -200rpx;
  background: transparent;
  box-shadow: none;
}
.theme-night .knock-pad,
.theme-ink .knock-pad,
.theme-dusk .knock-pad {
  background: transparent;
  box-shadow: none;
}
/* 飘字从木鱼上方升起，不压在木鱼身上 */
.float-text {
  bottom: 72%;
}

/* 木鱼材质色点：竖排在左侧，避开中间的敲击热区 */
.mat-dots {
  position: absolute;
  left: 40rpx;
  bottom: 40rpx;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mat-dot {
  width: 40rpx;
  height: 40rpx;
  margin-top: 24rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.18);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.mat-dot.on {
  box-shadow: 0 0 0 2rpx #e0b577, 0 0 0 8rpx rgba(224, 181, 119, 0.2);
  transform: scale(1.1);
}
.mat-dot-hover {
  opacity: 0.75;
}
