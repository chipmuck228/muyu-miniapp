.home-page {
  position: relative;
  background: #0a0806;
  overflow: hidden;
}
.home-page.theme-night {
  background: #05070c;
}
.home-page.theme-ink {
  background: #0b0b0b;
}
.home-page.theme-dusk {
  background: #0e0807;
}

/* 主题天色：上方天色 + 香案后的光晕，进门即可见 */
.theme-sky,
.theme-glow {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  transition: opacity 0.42s ease;
}
.theme-sky {
  background: linear-gradient(180deg, #1c140c 0%, #120d08 46%, #0a0806 100%);
}
.theme-glow {
  background: radial-gradient(ellipse 80% 42% at 50% 80%, rgba(200, 138, 74, 0.26) 0%, rgba(200, 138, 74, 0.08) 52%, rgba(200, 138, 74, 0) 100%);
}
.theme-night .theme-sky {
  background: linear-gradient(180deg, #0c1626 0%, #08101c 50%, #05070c 100%);
}
.theme-night .theme-glow {
  background:
    radial-gradient(circle at 74% 16%, rgba(196, 216, 246, 0.2) 0%, rgba(196, 216, 246, 0.05) 14%, rgba(196, 216, 246, 0) 30%),
    radial-gradient(ellipse 80% 42% at 50% 80%, rgba(111, 147, 196, 0.22) 0%, rgba(111, 147, 196, 0.06) 52%, rgba(111, 147, 196, 0) 100%);
}
.theme-ink .theme-sky {
  background: linear-gradient(180deg, #1e1e1d 0%, #141414 48%, #0b0b0b 100%);
}
.theme-ink .theme-glow {
  background: radial-gradient(ellipse 80% 42% at 50% 80%, rgba(206, 202, 192, 0.16) 0%, rgba(206, 202, 192, 0.05) 52%, rgba(206, 202, 192, 0) 100%);
}
.theme-dusk .theme-sky {
  background: linear-gradient(180deg, #2a1210 0%, #3a1a12 30%, #1a0d0a 64%, #0e0807 100%);
}
.theme-dusk .theme-glow {
  background: radial-gradient(ellipse 96% 46% at 50% 76%, rgba(224, 120, 74, 0.3) 0%, rgba(224, 120, 74, 0.09) 54%, rgba(224, 120, 74, 0) 100%);
}
.theme-night .dawn-paper {
  filter: brightness(0.42) saturate(0.55) hue-rotate(200deg);
}
.theme-ink .dawn-paper {
  filter: grayscale(1) brightness(0.5) contrast(1.08);
}
.theme-dusk .dawn-paper {
  filter: sepia(0.45) saturate(1.35) brightness(0.62) hue-rotate(-12deg);
}
.theme-night .knock-pad {
  background: radial-gradient(circle, rgba(150, 186, 214, 0.07) 0%, rgba(150, 186, 214, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(168, 196, 220, 0.22);
}
.theme-ink .knock-pad {
  background: radial-gradient(circle, rgba(220, 220, 216, 0.05) 0%, rgba(220, 220, 216, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(220, 220, 216, 0.18);
}
.theme-dusk .knock-pad {
  background: radial-gradient(circle, rgba(232, 150, 96, 0.08) 0%, rgba(232, 150, 96, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(232, 150, 96, 0.28);
}
.theme-night .ripple-ring {
  border-color: rgba(186, 214, 232, 0.88);
}
.theme-night .knock-glow,
.theme-night .knock-halo {
  background: radial-gradient(circle, rgba(170, 205, 240, 0.32) 0%, rgba(170, 205, 240, 0) 64%);
}
.theme-ink .knock-glow,
.theme-ink .knock-halo {
  background: radial-gradient(circle, rgba(236, 234, 228, 0.24) 0%, rgba(236, 234, 228, 0) 64%);
}
.theme-dusk .knock-glow,
.theme-dusk .knock-halo {
  background: radial-gradient(circle, rgba(255, 160, 100, 0.36) 0%, rgba(255, 160, 100, 0) 64%);
}
.theme-ink .ripple-ring {
  border-color: rgba(232, 232, 228, 0.75);
}
.theme-dusk .ripple-ring {
  border-color: rgba(240, 168, 112, 0.9);
}
.theme-night .float-text.score { color: #d5e6f4; }
.theme-night .float-text.milestone { color: #e4eefa; text-shadow: 0 0 24rpx rgba(150, 190, 240, 0.7); }
.theme-ink .float-text.milestone { color: #f4f2ec; text-shadow: 0 0 24rpx rgba(230, 228, 220, 0.5); }
.theme-dusk .float-text.milestone { color: #ffd9b8; text-shadow: 0 0 24rpx rgba(255, 140, 80, 0.7); }
.theme-night .float-text.chant { color: #b7c9dc; }
.theme-ink .float-text.score { color: #e6e4de; }
.theme-ink .float-text.chant { color: #bdb9b0; }
.theme-dusk .float-text.score { color: #ffc49a; }
.theme-dusk .float-text.chant { color: #f0d2bc; }

.enter-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(8, 6, 4, 0.86);
  pointer-events: auto;
}

.phase-reveal .enter-veil {
  animation: veil-out 0.48s ease forwards;
}

@keyframes veil-out {
  to { opacity: 0; }
}

.phase-cover .enter-altar {
  opacity: 0;
}
.phase-reveal .enter-altar {
  animation: altar-in 0.56s ease 0.12s both;
}
.phase-done .enter-altar {
  opacity: 1;
}
@keyframes altar-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.home-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

.dawn {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.dawn-paper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  transition: opacity 0.42s ease;
}
.smoke-gl-fill {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: block;
  overflow: hidden;
  pointer-events: none;
}

.void-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.void-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.void-fallback .ember {
  position: absolute;
  left: 50%;
  top: 72%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-top: -9rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ff5c2a 0%, rgba(120, 20, 0, 0) 70%);
  animation: ember-breathe 3.6s ease-in-out infinite;
}
.void-fallback .puff {
  position: absolute;
  left: 50%;
  top: 72%;
  width: 4rpx;
  height: 4rpx;
  margin-left: -2rpx;
  border-radius: 50%;
  background: rgba(196, 222, 226, 0.62);
  animation: puff-rise 9.2s linear infinite;
}
.void-fallback .puff.p0 { animation-delay: 0s; }
.void-fallback .puff.p1 { animation-delay: 1.1s; }
.void-fallback .puff.p2 { animation-delay: 2.2s; }
.void-fallback .puff.p3 { animation-delay: 3.3s; }
.void-fallback .puff.p4 { animation-delay: 4.4s; }
.void-fallback .puff.p5 { animation-delay: 5.5s; }
.void-fallback .puff.p6 { animation-delay: 6.6s; }
.void-fallback .puff.p7 { animation-delay: 7.7s; }
@keyframes ember-breathe {
  0%, 100% { opacity: 0.65; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.18); }
}
@keyframes puff-rise {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 0.7;
    filter: blur(0);
  }
  62% {
    transform: translate3d(2rpx, -38vh, 0) scale(1.8);
    opacity: 0.4;
    filter: blur(1rpx);
  }
  68% {
    transform: translate3d(4rpx, -40vh, 0) scale(2);
    opacity: 0.36;
    filter: blur(2rpx);
  }
  100% {
    transform: translate3d(72rpx, -52vh, 0) scale(6);
    opacity: 0;
    filter: blur(8rpx);
  }
}

.lesson-title-canvas {
  position: absolute;
  left: 50%;
  top: 18%;
  z-index: 7;
  width: 88rpx;
  height: 56%;
  margin-left: -44rpx;
  pointer-events: none;
}

.altar-fill {
  flex: 1;
  min-height: 0;
  pointer-events: none;
}

.knock-wrap {
  position: relative;
  flex-shrink: 0;
  height: 320rpx;
  z-index: 3;
}

.knock-pad {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  z-index: 3;
  width: 280rpx;
  height: 280rpx;
  margin-left: -140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 181, 119, 0.06) 0%, rgba(224, 181, 119, 0) 72%);
  box-shadow: inset 0 0 0 1rpx rgba(224, 181, 119, 0.16);
}

.knock-hover {
  opacity: 0.85;
}

.knock-pad.pulsing {
  animation: knock-bounce 0.22s ease-out;
}

@keyframes knock-bounce {
  0% { transform: scale(0.92); }
  45% { transform: scale(0.965); }
  70% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

.ripple-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 4;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  margin-top: -80rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 214, 140, 0.9);
  opacity: 0;
  pointer-events: none;
}
.ripple-ring.on {
  animation: ripple 0.7s ease-out;
}
@keyframes ripple {
  0% {
    opacity: 0.9;
    transform: scale(0.4);
  }
  100% {
    opacity: 0;
    transform: scale(2.8);
  }
}

.floats-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 5;
}
.float-text {
  position: absolute;
  bottom: 40%;
  font-size: 38rpx;
  font-weight: 700;
  white-space: nowrap;
  opacity: 0;
  animation: float-up 1s ease-out forwards;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.6);
}
.float-text.score {
  color: #ffd98a;
}
.float-text.chant {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  color: #f1dfc2;
}
.float-text.celebrate {
  color: #ff9d76;
  font-size: 44rpx;
}
@keyframes float-up {
  0% {
    opacity: 0;
    transform: translate(-50%, 10rpx) scale(0.6);
  }
  18% {
    opacity: 1;
    transform: translate(-50%, -30rpx) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -220rpx) scale(1);
  }
}

/* 顶部当前功课：轻触打开今日功课切换 */
.lesson-head {
  position: absolute;
  left: 40rpx;
  z-index: 8;
  max-width: 60%;
  padding: 8rpx 12rpx 12rpx 0;
}
.lesson-head-hover {
  opacity: 0.7;
}
.lh-row {
  display: flex;
  align-items: baseline;
}
.lh-name {
  min-width: 0;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lh-switch {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.lh-count {
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}
.lh-cur {
  font-size: 44rpx;
  color: #e8c98a;
}
.lh-goal {
  font-size: 28rpx;
  color: rgba(224, 181, 119, 0.55);
}
.lh-bar {
  margin-top: 12rpx;
  width: 320rpx;
  height: 4rpx;
  background: rgba(224, 181, 119, 0.16);
}
.lh-fill {
  height: 100%;
  background: #e0b577;
  transition: width 0.15s ease;
}

/* 心愿圆满弹窗 */
.celebrate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 6, 4, 0.78);
  animation: cel-fade 0.4s ease both;
}
.celebrate-card {
  width: 600rpx;
  padding: 64rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #16110d;
  border: 1rpx solid rgba(224, 181, 119, 0.28);
  animation: cel-rise 0.5s ease both;
}
.cel-kicker {
  font-size: 28rpx;
  letter-spacing: 12rpx;
  padding-left: 12rpx;
  color: rgba(224, 181, 119, 0.7);
}
.cel-name {
  margin-top: 24rpx;
  max-width: 100%;
  font-size: 44rpx;
  letter-spacing: 6rpx;
  color: #f3eadc;
  text-align: center;
}
.cel-goal {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: #e8c98a;
}
.cel-thumb {
  margin-top: 40rpx;
  width: 360rpx;
  height: 480rpx;
}
.cel-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.55);
}
.cel-actions {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  gap: 24rpx;
}
.cel-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #e8c98a;
  border: 1rpx solid rgba(224, 181, 119, 0.45);
}
.cel-btn.primary {
  background: #e0b577;
  border-color: #e0b577;
  color: #16110d;
}
.cel-hover {
  opacity: 0.75;
}
@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cel-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: none; }
}

/* 圆满后切换功课：弹窗里预告下一个，关掉后顶部再提示一次 */
.cel-next {
  margin-top: 40rpx;
  max-width: 100%;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.7);
  text-align: center;
}
.cel-next + .cel-actions {
  margin-top: 24rpx;
}
.lh-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
  animation: lh-hint 2.6s ease both;
}
@keyframes lh-hint {
  0% { opacity: 0; transform: translateY(-8rpx); }
  12%, 80% { opacity: 1; transform: none; }
  100% { opacity: 0; }
}
.lesson-head.switched .lh-name {
  animation: lh-glow 1.4s ease 2;
}
@keyframes lh-glow {
  0%, 100% { color: rgba(243, 234, 220, 0.88); }
  50% { color: #ffd98a; text-shadow: 0 0 16rpx rgba(255, 217, 138, 0.55); }
}

/* 3D 木鱼：舞台在敲击热区正下方，热区透明盖在上面接收点击 */
.knock-wrap {
  height: 480rpx;
}
.muyu-stage {
  position: absolute;
  left: 50%;
  bottom: 0;
  z-index: 2;
  width: 520rpx;
  height: 480rpx;
  margin-left: -260rpx;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.muyu-gl {
  display: block;
  width: 100%;
  height: 100%;
}
.knock-pad {
  bottom: 40rpx;
  width: 400rpx;
  height: 400rpx;
  margin-left: -200rpx;
  background: transparent;
  box-shadow: none;
}
.theme-night .knock-pad,
.theme-ink .knock-pad,
.theme-dusk .knock-pad {
  background: transparent;
  box-shadow: none;
}
/* 飘字从木鱼上方升起，不压在木鱼身上 */
.float-text {
  bottom: 72%;
}

/* 木鱼材质色点：竖排在左侧，避开中间的敲击热区 */
.mat-dots {
  position: absolute;
  left: 40rpx;
  bottom: 40rpx;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mat-dot {
  width: 40rpx;
  height: 40rpx;
  margin-top: 24rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.18);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.mat-dot.on {
  box-shadow: 0 0 0 2rpx #e0b577, 0 0 0 8rpx rgba(224, 181, 119, 0.2);
  transform: scale(1.1);
}
.mat-dot-hover {
  opacity: 0.75;
}

/* 今日功课底部面板 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 84;
  background: rgba(8, 6, 4, 0.6);
  animation: cel-fade 0.3s ease both;
}
.lesson-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 85;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #16110d;
  border-top: 1rpx solid rgba(224, 181, 119, 0.28);
  border-radius: 32rpx 32rpx 0 0;
  animation: sheet-up 0.36s ease both;
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: none; }
}
.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sheet-titles {
  display: flex;
  flex-direction: column;
}
.sheet-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  color: rgba(243, 234, 220, 0.92);
}
.sheet-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.6);
}
.sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.7);
}
.sheet-list {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}
.sheet-loading {
  display: block;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: rgba(224, 181, 119, 0.5);
}
.sheet-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.1);
}
.sheet-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-mark {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: rgba(224, 181, 119, 0.55);
  white-space: nowrap;
}
.sheet-row.cur .sheet-name,
.sheet-row.cur .sheet-mark {
  color: #e8c98a;
}
.sheet-new {
  border-bottom: none;
}
.sheet-new .sheet-name {
  color: rgba(224, 181, 119, 0.85);
}
.sheet-hover {
  opacity: 0.7;
}

.side-tools {
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 自动敲：关着是暗字，开着字亮起、小点缓缓呼吸 */
.auto-tog {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx;
}
.auto-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: rgba(224, 181, 119, 0.3);
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.auto-text {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(243, 234, 220, 0.4);
  transition: color 0.3s ease;
}
.auto-tog.on .auto-dot {
  background: #e8c98a;
  box-shadow: 0 0 10rpx rgba(232, 201, 138, 0.7);
  animation: auto-breathe 1.6s ease-in-out infinite;
}
.auto-tog.on .auto-text {
  color: #e8c98a;
}
@keyframes auto-breathe {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.incense-entry {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}
.incense-entry-icon {
  width: 4rpx;
  height: 56rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, #ff7a3a 0%, #8a3a1c 8%, #5a2e1a 100%);
  box-shadow: 0 -4rpx 12rpx rgba(255, 110, 50, 0.5);
}
.incense-entry-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  padding-left: 4rpx;
  color: rgba(224, 181, 119, 0.75);
}

.session-burn {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}
/* 香身从顶上往下烧短，底端不动 */
.session-icon {
  height: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}
.session-icon .incense-entry-icon {
  transition: height 0.5s linear;
}
.session-bead {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #c98a4a, #4a2616);
  box-shadow: 0 0 10rpx rgba(224, 181, 119, 0.35);
}
.session-big {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-variant-numeric: tabular-nums;
  color: #e8c98a;
}
.session-small {
  margin-top: 4rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.7);
}
.session-end {
  margin-top: 16rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  padding-left: 4rpx;
  color: rgba(243, 234, 220, 0.4);
}

.sheet-section {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.45);
}
.sheet-row.locked .sheet-name {
  color: rgba(243, 234, 220, 0.6);
}
.incense-rule {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(243, 234, 220, 0.5);
}
/* 圆满的飘字停得久一些 */
.float-text.celebrate {
  animation-duration: 2.4s;
}

/* ===== 敲击反馈：一圈光晕闪一下 + 两道涟漪 ===== */
.knock-glow,
.knock-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 440rpx;
  height: 440rpx;
  margin-left: -220rpx;
  margin-top: -220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 210, 140, 0.34) 0%, rgba(255, 210, 140, 0) 64%);
  opacity: 0;
  pointer-events: none;
}
.knock-glow.on {
  animation: knock-glow 0.5s ease-out;
}
@keyframes knock-glow {
  0% { opacity: 0.9; transform: scale(0.82); }
  100% { opacity: 0; transform: scale(1.12); }
}
.ripple-ring.r2 {
  border-width: 2rpx;
  border-color: rgba(255, 224, 170, 0.6);
}
.ripple-ring.r2.on {
  animation: ripple 1.1s ease-out 0.08s;
}
.theme-night .ripple-ring.r2 { border-color: rgba(200, 222, 240, 0.55); }
.theme-ink .ripple-ring.r2 { border-color: rgba(236, 236, 232, 0.5); }
.theme-dusk .ripple-ring.r2 { border-color: rgba(255, 196, 150, 0.6); }

/* 今天还没敲过：木鱼周围一圈光慢慢呼吸，下面一行小字 */
.knock-pad.hinting .knock-halo {
  animation: knock-halo 2.8s ease-in-out infinite;
}
@keyframes knock-halo {
  0%, 100% { opacity: 0.15; transform: scale(0.86); }
  50% { opacity: 0.75; transform: scale(1); }
}
.knock-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(243, 226, 194, 0.55);
  pointer-events: none;
  animation: hint-breathe 2.8s ease-in-out infinite;
}
@keyframes hint-breathe {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

/* 里程碑：今日第一叩、整百、心愿过半、升称号 */
.float-text.milestone {
  bottom: 76%;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
  padding-left: 10rpx;
  color: #ffe2a8;
  text-shadow: 0 0 24rpx rgba(255, 196, 110, 0.65), 0 2rpx 10rpx rgba(0, 0, 0, 0.6);
  font-family: var(--serif);
  animation: float-milestone 2.4s ease-out forwards;
}
@keyframes float-milestone {
  0% { opacity: 0; transform: translate(-50%, 20rpx) scale(0.8); letter-spacing: 2rpx; }
  16% { opacity: 1; transform: translate(-50%, -16rpx) scale(1); }
  70% { opacity: 1; transform: translate(-50%, -60rpx) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -120rpx) scale(1); letter-spacing: 16rpx; }
}

/* 顶部：今日叩数 + 期限 */
.lh-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.42);
  font-variant-numeric: tabular-nums;
}
.lh-due {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  color: rgba(232, 201, 138, 0.85);
  background: rgba(224, 181, 119, 0.1);
}
.lh-due.late {
  color: rgba(240, 150, 120, 0.9);
  background: rgba(220, 110, 80, 0.12);
}
.lh-bar {
  border-radius: 2rpx;
  overflow: hidden;
}
.lh-fill {
  background: linear-gradient(90deg, #c99a5c, #f0cf8e);
  box-shadow: 0 0 8rpx rgba(240, 207, 142, 0.6);
}

/* 换材质：选中的色点旁亮出名字 */
.mat-dot {
  position: relative;
}
.mat-label {
  position: absolute;
  left: 60rpx;
  top: 50%;
  margin-top: -18rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  white-space: nowrap;
  color: #e8c98a;
  opacity: 0;
  transform: translateX(-8rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}
.mat-label.on {
  opacity: 1;
  transform: none;
}

/* ===== 底部面板 ===== */
.sheet-grip {
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 64rpx;
  height: 6rpx;
  margin-left: -32rpx;
  border-radius: 3rpx;
  background: rgba(243, 234, 220, 0.16);
}
.lesson-sheet {
  background: linear-gradient(180deg, #1d1610 0%, #15100b 40%, #120d09 100%);
  box-shadow: 0 -24rpx 64rpx rgba(0, 0, 0, 0.5);
}
.sheet-title {
  font-family: var(--serif);
  font-weight: 500;
}
.sheet-row {
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 28rpx 4rpx;
}
.sheet-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sheet-bar {
  margin-top: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(224, 181, 119, 0.1);
  overflow: hidden;
}
.sheet-bar-fill {
  height: 100%;
  border-radius: 2rpx;
  background: rgba(224, 181, 119, 0.45);
}
.sheet-row.cur .sheet-bar-fill {
  background: linear-gradient(90deg, #c99a5c, #f0cf8e);
}
.sheet-row.cur .sheet-name::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin: 0 14rpx 4rpx 0;
  border-radius: 50%;
  background: #e8c98a;
  box-shadow: 0 0 10rpx rgba(232, 201, 138, 0.8);
  vertical-align: middle;
}

/* 成品定课：左侧一枚色点，右侧小签 */
.plan-row {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}
.plan-mark {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}
.plan-rain .plan-mark {
  background: radial-gradient(circle at 35% 30%, #d9c49a 0%, #8a6a3e 46%, #2a1e12 100%);
}
.plan-pine .plan-mark {
  background: radial-gradient(circle at 35% 30%, #c9d2c2 0%, #5f6e5a 46%, #1a1e18 100%);
}
.plan-night .plan-mark {
  background: radial-gradient(circle at 35% 30%, #c4d6f0 0%, #4a6890 46%, #0c1424 100%);
}
.plan-text {
  flex: 1;
  min-width: 0;
}
.plan-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.42);
}
.plan-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
  border: 1rpx solid rgba(224, 181, 119, 0.4);
}
.sheet-row.locked .plan-mark {
  opacity: 0.55;
}

/* 自己敲：一炷香 / 一串念珠，后面一排小签 */
.self-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.self-head {
  flex-shrink: 0;
}
.chip-row {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.chip {
  margin: 6rpx 0 6rpx 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #e8c98a;
  background: rgba(224, 181, 119, 0.08);
  border: 1rpx solid rgba(224, 181, 119, 0.32);
}
.chip-hover {
  background: rgba(224, 181, 119, 0.22);
}

/* ===== 弹窗卡片 ===== */
.celebrate-card {
  position: relative;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #221a12 0%, #17110c 60%, #120d09 100%);
  box-shadow: 0 32rpx 96rpx rgba(0, 0, 0, 0.6), inset 0 1rpx 0 rgba(255, 230, 190, 0.08);
  overflow: hidden;
}
.cel-name {
  font-family: var(--serif);
  position: relative;
}
.cel-btn {
  border-radius: 44rpx;
}
.cel-btn.primary {
  background: linear-gradient(135deg, #f0cf8e, #d9a866 60%, #c4925a);
  border-color: transparent;
  box-shadow: 0 10rpx 28rpx rgba(224, 181, 119, 0.25);
}
.cel-kicker,
.cel-goal,
.cel-next,
.cel-hint,
.cel-actions,
.cel-thumb {
  position: relative;
}

/* 定课收尾：一枚钟钵 */
.done-card {
  padding-top: 56rpx;
}
.bell-mark {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 38%, #f3d79c 0%, #c4925a 42%, #6a4522 100%);
  box-shadow: 0 0 40rpx rgba(232, 190, 120, 0.35);
}
.bell-mark::after {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 22rpx;
  bottom: 22rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 30%, #3a2614 0%, #1c120a 100%);
}
.bell-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96rpx;
  height: 96rpx;
  margin: -48rpx 0 0 -48rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(240, 207, 142, 0.7);
  animation: bell-wave 2.4s ease-out infinite;
}
@keyframes bell-wave {
  0% { opacity: 0.9; transform: scale(1); }
  100% { opacity: 0; transform: scale(2.2); }
}

/* 心愿圆满：金色光晕、莲花、落英 */
.wish-card {
  padding-top: 48rpx;
}
.cel-halo {
  position: absolute;
  left: 50%;
  top: -240rpx;
  width: 640rpx;
  height: 640rpx;
  margin-left: -320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 210, 140, 0.24) 0%, rgba(255, 210, 140, 0.06) 40%, rgba(255, 210, 140, 0) 70%);
  animation: halo-breathe 4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes halo-breathe {
  0%, 100% { opacity: 0.7; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); }
}
.cel-lotus {
  position: relative;
  width: 96rpx;
  height: 72rpx;
  margin-bottom: 20rpx;
  animation: lotus-rise 0.9s ease 0.15s both;
}
.cl-petal {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34rpx;
  height: 68rpx;
  margin-left: -17rpx;
  border-radius: 50% 50% 46% 46% / 60% 60% 40% 40%;
  background: linear-gradient(180deg, #ffe7b8 0%, #e3b071 60%, rgba(196, 140, 80, 0.5) 100%);
  transform-origin: 50% 100%;
  box-shadow: 0 0 20rpx rgba(255, 200, 120, 0.35);
}
.cl-petal.l { transform: rotate(-38deg); opacity: 0.8; }
.cl-petal.r { transform: rotate(38deg); opacity: 0.8; }
@keyframes lotus-rise {
  from { opacity: 0; transform: translateY(16rpx) scale(0.7); }
  to { opacity: 1; transform: none; }
}

.petals {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}
.petal {
  position: absolute;
  top: -40rpx;
  width: 18rpx;
  height: 26rpx;
  border-radius: 50% 50% 50% 50% / 64% 64% 36% 36%;
  background: linear-gradient(180deg, rgba(255, 226, 170, 0.95), rgba(226, 168, 98, 0.6));
  opacity: 0;
  animation: petal-fall 6s linear infinite;
}
.petal.p0 { left: 6%; animation-delay: 0s; }
.petal.p1 { left: 18%; animation-delay: 1.4s; animation-duration: 7s; }
.petal.p2 { left: 29%; animation-delay: 0.6s; transform: scale(0.7); }
.petal.p3 { left: 41%; animation-delay: 2.6s; animation-duration: 6.6s; }
.petal.p4 { left: 52%; animation-delay: 0.3s; animation-duration: 7.4s; }
.petal.p5 { left: 63%; animation-delay: 1.9s; }
.petal.p6 { left: 74%; animation-delay: 3.2s; animation-duration: 6.8s; }
.petal.p7 { left: 85%; animation-delay: 1s; animation-duration: 7.6s; }
.petal.p8 { left: 93%; animation-delay: 2.2s; }
.petal.p9 { left: 12%; animation-delay: 3.8s; animation-duration: 8s; }
.petal.p10 { left: 47%; animation-delay: 4.4s; animation-duration: 7.2s; }
.petal.p11 { left: 79%; animation-delay: 5s; animation-duration: 6.4s; }
@keyframes petal-fall {
  0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(0deg); }
  10% { opacity: 0.9; }
  85% { opacity: 0.6; }
  100% { opacity: 0; transform: translate3d(80rpx, 110vh, 0) rotate(300deg); }
}

/* ===== 主题点缀：夜偏银蓝、墨偏骨白、霞偏霞红，香案上的字和进度跟着换 ===== */
.theme-night .lh-cur,
.theme-night .session-big,
.theme-night .mat-label,
.theme-night .lh-hint { color: #d3e3f6; }
.theme-night .lh-switch,
.theme-night .lh-goal,
.theme-night .incense-entry-text,
.theme-night .session-small,
.theme-night .knock-hint { color: rgba(184, 208, 236, 0.6); }
.theme-night .lh-bar { background: rgba(170, 200, 236, 0.16); }
.theme-night .lh-fill { background: linear-gradient(90deg, #6f93c4, #d3e3f6); box-shadow: 0 0 8rpx rgba(190, 215, 245, 0.6); }
.theme-night .lh-due { color: #d3e3f6; background: rgba(150, 185, 230, 0.14); }
.theme-night .auto-tog.on .auto-text { color: #d3e3f6; }
.theme-night .auto-tog.on .auto-dot { background: #d3e3f6; box-shadow: 0 0 10rpx rgba(200, 222, 248, 0.7); }
.theme-night .mat-dot.on { box-shadow: 0 0 0 2rpx #b8d0ec, 0 0 0 8rpx rgba(184, 208, 236, 0.2); }

.theme-ink .lh-cur,
.theme-ink .session-big,
.theme-ink .mat-label,
.theme-ink .lh-hint { color: #eeebe4; }
.theme-ink .lh-switch,
.theme-ink .lh-goal,
.theme-ink .incense-entry-text,
.theme-ink .session-small,
.theme-ink .knock-hint { color: rgba(222, 218, 210, 0.55); }
.theme-ink .lh-bar { background: rgba(230, 228, 222, 0.14); }
.theme-ink .lh-fill { background: linear-gradient(90deg, #8c8880, #eeebe4); box-shadow: 0 0 8rpx rgba(238, 235, 228, 0.45); }
.theme-ink .lh-due { color: #eeebe4; background: rgba(230, 228, 222, 0.1); }
.theme-ink .auto-tog.on .auto-text { color: #eeebe4; }
.theme-ink .auto-tog.on .auto-dot { background: #eeebe4; box-shadow: 0 0 10rpx rgba(238, 235, 228, 0.6); }
.theme-ink .mat-dot.on { box-shadow: 0 0 0 2rpx #dcd8d0, 0 0 0 8rpx rgba(220, 216, 208, 0.18); }

.theme-dusk .lh-cur,
.theme-dusk .session-big,
.theme-dusk .mat-label,
.theme-dusk .lh-hint { color: #ffcfa8; }
.theme-dusk .lh-switch,
.theme-dusk .lh-goal,
.theme-dusk .incense-entry-text,
.theme-dusk .session-small,
.theme-dusk .knock-hint { color: rgba(246, 176, 136, 0.65); }
.theme-dusk .lh-bar { background: rgba(240, 150, 110, 0.18); }
.theme-dusk .lh-fill { background: linear-gradient(90deg, #c8643c, #ffcfa8); box-shadow: 0 0 8rpx rgba(255, 180, 130, 0.6); }
.theme-dusk .lh-due { color: #ffcfa8; background: rgba(240, 140, 100, 0.14); }
.theme-dusk .auto-tog.on .auto-text { color: #ffcfa8; }
.theme-dusk .auto-tog.on .auto-dot { background: #ffcfa8; box-shadow: 0 0 10rpx rgba(255, 190, 140, 0.7); }
.theme-dusk .mat-dot.on { box-shadow: 0 0 0 2rpx #f0a878, 0 0 0 8rpx rgba(240, 168, 120, 0.22); }

/* 面板里还没有心愿时的灵感小签 */
.sheet-ideas {
  padding: 24rpx 4rpx 28rpx;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.1);
}
.sheet-ideas-label {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(243, 234, 220, 0.5);
}
.idea-row {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0 0 -10rpx;
}

/* 圆满卡里的壁纸缩略图 */
.cel-thumb {
  border-radius: 12rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5), 0 0 0 1rpx rgba(224, 181, 119, 0.18);
}

/* 过期的期限在哪个主题下都是红的 */
.home-page .lh-due.late {
  color: rgba(240, 150, 120, 0.9);
  background: rgba(220, 110, 80, 0.12);
}
