<!-- 木鱼香案：WebGL 3D 木鱼 + 其上的透明敲击热区 -->
<view class="page home-page theme-{{theme}} phase-{{enterPhase}} kind-{{enterKind}}">
  <view class="enter-veil" wx:if="{{enterPhase !== 'done'}}" catchtouchmove="noop"></view>

  <block wx:if="{{readyToKnock}}">
    <view class="home-stage">
      <view class="dawn">
        <!-- 主题天色：常驻，不随进度变；进度推进时天空图再叠上来 -->
        <view class="theme-sky"></view>
        <view class="theme-glow"></view>
        <image wx:if="{{dawnSrc}}" class="dawn-paper" src="{{dawnSrc}}" mode="aspectFill" style="opacity: {{dawnSky}};" />
      </view>
      <smoke-gl class="smoke-gl-fill" theme="{{theme}}" sink="{{incenseSink}}" fade="{{celebrateOn || sheetOn || incenseSheetOn ? 0 : (incenseOn ? 1 : smokeFade)}}" bind:risen="onSmokeRisen" />
      <!-- 一炷香：香身从烟头插进香炉，燃烧时一起往下走 -->
      <block wx:if="{{incenseOn && !celebrateOn}}">
        <view class="incense-stick" style="top: {{incenseTop}}%; height: {{incenseLen}}%;"></view>
        <view class="incense-censer" style="top: {{incenseTop + incenseLen}}%;"></view>
      </block>

      <view
        class="lesson-head enter-altar {{switchHint ? 'switched' : ''}}"
        style="top: {{statusBarHeight + 10}}px;"
        hover-class="lesson-head-hover"
        bindtap="onOpenLessonPanel"
      >
        <view class="lh-row">
          <text class="lh-name">{{lessonTitle}}{{headWish ? '' : ' · 今日 ' + todayCount}}</text>
          <text class="lh-switch">切换 ›</text>
        </view>
        <block wx:if="{{headWish && headReady}}">
          <view class="lh-count">
            <text class="lh-cur">{{headCur}}</text>
            <text class="lh-goal"> / {{headGoal}}</text>
          </view>
          <view class="lh-bar"><view class="lh-fill" style="width: {{headPct}}%;"></view></view>
        </block>
        <text wx:if="{{switchHint}}" class="lh-hint">{{switchHint}}</text>
      </view>

      <view class="altar-fill enter-altar"></view>
      <!-- 竖排功课名只画在 canvas 上（同层压得住青烟）；以前另有一份 DOM 文字，行距对不上会重影 -->
      <canvas type="2d" id="lessonTitleCanvas" class="lesson-title-canvas"></canvas>

      <view class="knock-wrap enter-altar">
        <!-- 木鱼只负责显示，不接收点击；圆满弹窗打开时隐去，免得画布盖在弹窗上 -->
        <view class="muyu-stage" style="opacity: {{celebrateOn || sheetOn || incenseSheetOn || incenseOn ? 0 : 1}};">
          <muyu-gl id="muyu" class="muyu-gl" strike="{{strikeSeq}}" material="{{material}}" paused="{{celebrateOn || sheetOn || incenseSheetOn || incenseOn}}" />
        </view>
        <view
          wx:if="{{!incenseOn}}"
          class="knock-pad {{pulsing ? 'pulsing' : ''}}"
          hover-class="knock-hover"
          hover-stay-time="60"
          bindtap="onKnockTap"
          bindtouchstart="onPadTouchStart"
          bindtouchmove="onPadTouchMove"
          bindtouchend="onPadTouchEnd"
          bindtouchcancel="onPadTouchEnd"
        >
          <view class="ripple-ring {{rippleOn ? 'on' : ''}}"></view>
        </view>
        <!-- 木鱼材质：紫檀 / 黄花梨 / 琉璃 / 玉 -->
        <view class="mat-dots" wx:if="{{!incenseOn}}">
          <view
            wx:for="{{materials}}"
            wx:key="id"
            class="mat-dot {{material === item.id ? 'on' : ''}}"
            style="background: {{item.dot}};"
            hover-class="mat-dot-hover"
            data-id="{{item.id}}"
            catchtap="onPickMaterial"
          ></view>
        </view>
        <!-- 右下角：自动敲开关 + 一炷香入口；燃烧时换成倒计时 -->
        <view wx:if="{{!incenseOn}}" class="side-tools">
          <view class="auto-tog {{autoMode ? 'on' : ''}}" hover-class="mat-dot-hover" catchtap="onToggleAuto">
            <view class="auto-dot"></view>
            <text class="auto-text">自动</text>
          </view>
          <view wx:if="{{incenseFeature}}" class="incense-entry" hover-class="mat-dot-hover" catchtap="onOpenIncense">
            <view class="incense-entry-icon"></view>
            <text class="incense-entry-text">一炷香</text>
          </view>
        </view>
        <view wx:else class="incense-burn">
          <text class="incense-clock">{{incenseLeft}}</text>
          <text class="incense-gain">燃尽积专注 {{incenseGain}}</text>
          <text class="incense-note">可以锁屏或离开，香照常燃</text>
          <text class="incense-snuff" hover-class="mat-dot-hover" catchtap="onSnuffIncense">掐灭</text>
        </view>
        <view class="floats-layer">
          <view
            wx:for="{{floats}}"
            wx:key="key"
            class="float-text {{item.kind}}"
            style="left: {{item.left}}%;"
          >{{item.text}}</view>
        </view>
      </view>

      <hall-dock mode="hall" current="{{0}}" />
    </view>
  </block>

  <!-- 今日功课：底部面板，切换心愿 / 随机专注 / 立新愿 -->
  <view class="sheet-mask" wx:if="{{sheetOn}}" catchtouchmove="noop" bindtap="closeSheet"></view>
  <view class="lesson-sheet" wx:if="{{sheetOn}}" catchtouchmove="noop">
    <view class="sheet-head">
      <view class="sheet-titles">
        <text class="sheet-title">今日功课</text>
        <text class="sheet-sub">{{sheetFirst ? '一念既起 · 选一件事来专注' : '一念既起 · 功课自成'}}</text>
      </view>
      <text class="sheet-close" hover-class="sheet-hover" bindtap="closeSheet">收起</text>
    </view>
    <scroll-view class="sheet-list" scroll-y enhanced show-scrollbar="{{false}}">
      <text class="sheet-loading" wx:if="{{sheetLoading}}">正在取心愿…</text>
      <view
        wx:for="{{sheetRows}}"
        wx:key="_id"
        class="sheet-row {{item.cur ? 'cur' : ''}}"
        hover-class="sheet-hover"
        data-id="{{item._id}}"
        bindtap="onSheetPick"
      >
        <text class="sheet-name">{{item.name}}</text>
        <text class="sheet-mark">{{item.cur ? '当前 · ' : ''}}{{item.mark}}</text>
      </view>
      <view class="sheet-row {{sheetRandomCur ? 'cur' : ''}}" hover-class="sheet-hover" bindtap="onSheetRandom">
        <text class="sheet-name">随机专注</text>
        <text class="sheet-mark">{{sheetRandomCur ? '当前 · ' : ''}}不记心愿，随缘叩击</text>
      </view>
      <view class="sheet-row sheet-new" hover-class="sheet-hover" bindtap="onSheetNew">
        <text class="sheet-name">＋ 立新愿</text>
      </view>
    </scroll-view>
  </view>

  <!-- 一炷香：选时长即点燃 -->
  <view class="sheet-mask" wx:if="{{incenseSheetOn}}" catchtouchmove="noop" bindtap="closeIncenseSheet"></view>
  <view class="lesson-sheet" wx:if="{{incenseSheetOn}}" catchtouchmove="noop">
    <view class="sheet-head">
      <view class="sheet-titles">
        <text class="sheet-title">一炷香</text>
        <text class="sheet-sub">为「{{lessonTitle}}」 · 放下手机去做事</text>
      </view>
      <text class="sheet-close" hover-class="sheet-hover" bindtap="closeIncenseSheet">收起</text>
    </view>
    <view class="sheet-list">
      <view
        wx:for="{{incenseOptions}}"
        wx:key="minutes"
        class="sheet-row {{incenseBusy ? 'busy' : ''}}"
        hover-class="sheet-hover"
        data-minutes="{{item.minutes}}"
        bindtap="onLightIncense"
      >
        <text class="sheet-name">{{item.minutes}} 分钟</text>
        <text class="sheet-mark">燃尽积专注 {{item.gain}}</text>
      </view>
    </view>
    <text class="incense-rule">香燃时木鱼静置。锁屏、切到别的应用都不影响，燃尽回来即入账；中途掐灭不计。</text>
  </view>

  <!-- 心愿圆满 -->
  <view class="celebrate-mask" wx:if="{{celebrateOn && celebrate}}" catchtouchmove="noop">
    <view class="celebrate-card">
      <text class="cel-kicker">心愿圆满</text>
      <text class="cel-name">{{celebrate.name}}</text>
      <text class="cel-goal">专注 {{celebrate.goalText}}</text>
      <image wx:if="{{celebrate.thumbUrl}}" class="cel-thumb" src="{{celebrate.thumbUrl}}" mode="aspectFill" />
      <text wx:if="{{celebrate.thumbUrl}}" class="cel-hint">惊喜已启 · 可在心愿详情存入相册</text>
      <text wx:if="{{celebrate.nextText}}" class="cel-next">{{celebrate.nextText}}</text>
      <view class="cel-actions">
        <view class="cel-btn primary" hover-class="cel-hover" bindtap="onCelebrateCert">查看证书</view>
        <view class="cel-btn" hover-class="cel-hover" bindtap="onCelebrateContinue">继续敲击</view>
      </view>
    </view>
  </view>
</view>
