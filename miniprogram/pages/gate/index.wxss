.gate {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #120e0a;
}

.gate-bg-wrap {
  position: absolute;
  left: -6%;
  top: -6%;
  width: 112%;
  height: 112%;
  overflow: hidden;
}

.gate-bg {
  width: 100%;
  height: 100%;
  animation: kenburns 12s ease-out forwards;
}

@keyframes kenburns {
  from { transform: scale(1.06); }
  to { transform: scale(1.12); }
}

.gate-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background:
    radial-gradient(80% 50% at 50% 42%, rgba(18, 14, 10, 0.15), rgba(18, 14, 10, 0.72) 70%),
    linear-gradient(180deg, rgba(12, 9, 6, 0.35) 0%, rgba(12, 9, 6, 0.55) 100%);
  pointer-events: none;
}

.gate-bloom {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;
  margin-top: -280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 181, 119, 0.2) 0%, rgba(224, 181, 119, 0) 68%);
  animation: bloom 4.8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes bloom {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.08); }
}

.gate-brand {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 8vh;
}

.lotus {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 36rpx;
  opacity: 0;
  animation: fade-up 1.15s ease 0.4s forwards;
}

.lotus-petal {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 48rpx;
  margin-left: -11rpx;
  margin-top: -40rpx;
  border-radius: 50% 50% 46% 46%;
  background: linear-gradient(180deg, rgba(240, 214, 170, 0.55), rgba(180, 130, 70, 0.12));
  transform-origin: 50% 88%;
}
.lotus-petal.a { transform: rotate(0deg); }
.lotus-petal.b { transform: rotate(60deg); }
.lotus-petal.c { transform: rotate(-60deg); }
.lotus-petal.b,
.lotus-petal.c {
  opacity: 0.75;
}
.lotus-core {
  position: absolute;
  left: 50%;
  top: 58%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  margin-top: -7rpx;
  border-radius: 50%;
  background: rgba(232, 196, 130, 0.7);
  box-shadow: 0 0 16rpx rgba(224, 181, 119, 0.55);
}

.gate-title {
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: 28rpx;
  padding-left: 28rpx;
  color: #f3eadc;
  opacity: 0;
  animation: fade-up 1.2s ease 1s forwards;
}

.gate-sub {
  margin-top: 22rpx;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: rgba(224, 181, 119, 0.72);
  opacity: 0;
  animation: fade-up 1.25s ease 1.65s forwards;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: none; }
}

.gate.leaving .gate-brand,
.gate.leaving .gate-bloom,
.gate.leaving .gate-shade,
.gate.leaving .gate-bg-wrap {
  animation: fade-away 0.66s ease forwards;
}

@keyframes fade-away {
  to { opacity: 0; }
}
