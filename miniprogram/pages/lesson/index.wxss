.lesson {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #0a0806;
  padding: 0 56rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lesson-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 88rpx;
  opacity: 0;
  animation: fade-up 1.05s ease 0.2s forwards;
}

.lesson-kicker {
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  padding-left: 24rpx;
  color: rgba(240, 230, 216, 0.82);
}

.lesson-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: rgba(224, 181, 119, 0.7);
}

.paths {
  width: 100%;
  max-width: 560rpx;
  opacity: 0;
  animation: fade-up 1.1s ease 0.55s forwards;
}

.path {
  padding: 36rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(224, 181, 119, 0.12);
}

.path:last-child {
  border-bottom: none;
}

.path-name {
  font-size: 34rpx;
  letter-spacing: 6rpx;
  color: rgba(243, 234, 220, 0.82);
}

.path.on .path-name,
.path-hover .path-name {
  color: #e8c98a;
}

.wish-panel {
  width: 100%;
  max-width: 560rpx;
  max-height: 42vh;
  margin-top: 36rpx;
  overflow-y: auto;
  opacity: 0;
  animation: fade-up 0.5s ease forwards;
}

.wish-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.wish-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: #f0e6d8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-mark {
  margin-left: 24rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 181, 119, 0.45);
}

.wish-hover {
  opacity: 0.7;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 8rpx;
}

.empty-title {
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: #f0e6d8;
}

.empty-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.55);
}

.empty-go {
  margin-top: 36rpx;
  padding: 12rpx 8rpx;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  color: #e0b577;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: none; }
}

.lesson-back {
  position: absolute;
  left: 40rpx;
  z-index: 2;
  padding: 12rpx 8rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(224, 181, 119, 0.55);
}

.wish-row.cur .wish-name {
  color: #e8c98a;
}
.wish-row.cur .wish-mark {
  color: rgba(232, 201, 138, 0.8);
}

.wish-add {
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: rgba(224, 181, 119, 0.7);
}
