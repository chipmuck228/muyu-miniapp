<!-- 今日功课：冷启动入堂之后，选心愿或随机专注，再进香案 -->
<view class="lesson" catchtouchmove="noop">
  <view class="lesson-brand">
    <text class="lesson-kicker">今日功课</text>
    <text class="lesson-sub">一念既起 · 功课自成</text>
  </view>

  <view class="paths">
    <view class="path {{wishOpen ? 'on' : ''}}" hover-class="path-hover" bindtap="onWishPath">
      <text class="path-name">按照心愿单轻叩</text>
    </view>
    <view class="path" hover-class="path-hover" bindtap="onRandom">
      <text class="path-name">随机专注</text>
    </view>
  </view>

  <view class="wish-panel" wx:if="{{wishOpen && loaded}}">
    <block wx:if="{{wishes.length}}">
      <view
        wx:for="{{wishes}}"
        wx:key="_id"
        class="wish-row"
        hover-class="wish-hover"
        data-id="{{item._id}}"
        bindtap="onPickWish"
      >
        <text class="wish-name">{{item.name}}</text>
        <text class="wish-mark">{{item.mark}}</text>
      </view>
    </block>
    <view class="empty" wx:else>
      <text class="empty-title">尚未立愿</text>
      <text class="empty-sub">先许一心，再来叩击</text>
      <view class="empty-go" hover-class="path-hover" bindtap="onGoForm">去立愿</view>
    </view>
  </view>
</view>
