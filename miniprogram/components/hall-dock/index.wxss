.dock-root {
  position: relative;
  z-index: 21;
  width: 100%;
  flex-shrink: 0;
}

.exit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(8, 6, 4, 0.28);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.48s ease;
}
.exit-mask.on {
  opacity: 1;
  pointer-events: auto;
}

.exit-dock {
  position: relative;
  z-index: 21;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.exit-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 8rpx;
  opacity: 0;
  transform: translateY(14rpx);
  pointer-events: none;
  transition: opacity 0.48s ease, transform 0.48s ease;
}
.exit-dock.open .exit-row,
.exit-dock.wing .exit-row {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

.exit-item {
  font-size: 28rpx;
  letter-spacing: 8rpx;
  padding: 16rpx 8rpx 16rpx 16rpx;
  color: rgba(224, 181, 119, 0.8);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.7);
  opacity: 0;
  transform: translateY(10rpx);
  transition: opacity 0.5s ease, transform 0.5s ease, color 0.3s ease;
}
.exit-dock.open .exit-item,
.exit-dock.wing .exit-item {
  opacity: 1;
  transform: none;
}
.exit-dock.open .exit-item:nth-child(1),
.exit-dock.wing .exit-item:nth-child(1) { transition-delay: 0.02s; }
.exit-dock.open .exit-item:nth-child(2),
.exit-dock.wing .exit-item:nth-child(2) { transition-delay: 0.08s; }
.exit-dock.open .exit-item:nth-child(3),
.exit-dock.wing .exit-item:nth-child(3) { transition-delay: 0.14s; }
.exit-dock.open .exit-item:nth-child(4),
.exit-dock.wing .exit-item:nth-child(4) { transition-delay: 0.2s; }
.exit-dock.hall:not(.open) .exit-item {
  transition-delay: 0s;
}

.exit-item.current {
  color: #f0cf8e;
  text-shadow: 0 0 16rpx rgba(240, 207, 142, 0.45);
}

.exit-hover {
  opacity: 0.55;
}

.exit-hair {
  width: 200rpx;
  min-height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.exit-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  padding-left: 6rpx;
  color: rgba(224, 181, 119, 0.6);
}

.exit-hair-hover {
  opacity: 0.7;
}

/* 底部菜单统一用箭头：收起时向上并轻轻浮动；展开（含侧殿各页）时向下 */
.exit-chevron {
  width: 22rpx;
  height: 22rpx;
  margin-top: 12rpx;
  border-left: 3rpx solid rgba(224, 181, 119, 0.7);
  border-top: 3rpx solid rgba(224, 181, 119, 0.7);
  transform: rotate(45deg);
  animation: chevron-hint 2.4s ease-in-out infinite;
  transition: transform 0.48s ease;
}
.exit-dock.open .exit-chevron,
.exit-dock.wing .exit-chevron {
  margin-top: 0;
  transform: rotate(225deg);
  animation: none;
}
@keyframes chevron-hint {
  0%, 100% { transform: translateY(0) rotate(45deg); opacity: 0.55; }
  50% { transform: translateY(-8rpx) rotate(45deg); opacity: 1; }
}
