.muyu-root {
  position: relative;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.muyu-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.muyu-fallback {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 372rpx;
  height: 284rpx;
  margin-left: -186rpx;
  margin-top: -142rpx;
  border-radius: 50%;
  background: radial-gradient(at 34% 24%, #a55014, #6b2f0c 56%, #351706);
  box-shadow: inset 0 -20rpx 44rpx rgba(0, 0, 0, 0.55), 0 36rpx 68rpx rgba(0, 0, 0, 0.5);
}
.muyu-fallback-slot {
  position: absolute;
  left: 72rpx;
  top: 140rpx;
  width: 224rpx;
  height: 36rpx;
  border-radius: 20rpx;
  background: #200e04;
  transform: rotate(-4deg);
}
