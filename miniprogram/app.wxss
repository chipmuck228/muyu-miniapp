/**
 * app.wxss —— 全局样式
 * 设计基调：温润暗色 + 鎏金点缀（禅意）
 * 字体栈：优先系统默认 PingFang SC
 */
page {
  /* 标题用宋体，像经折上的字；没有宋体的机型退回系统字 */
  --serif: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', 'Noto Serif SC', serif;
  background: #16110d;
  color: #f0e6d8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 34rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 页面根容器：垂直 flex，状态栏由各页自行 padding-top */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(120% 60% at 50% -10%, rgba(212, 165, 116, 0.10), rgba(212, 165, 116, 0) 60%),
    linear-gradient(180deg, #1c1510 0%, #14100c 100%);
  overflow: hidden;
}

/* 侧殿：心愿 / 立愿 / 证书 / 静心 */
.wing-page {
  position: relative;
  background:
    radial-gradient(110% 48% at 50% -8%, rgba(224, 181, 119, 0.06), rgba(224, 181, 119, 0) 58%),
    linear-gradient(180deg, #120e0a 0%, #0a0806 100%);
}
.wing-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}
.wing-head.has-kicker {
  justify-content: space-between;
}
.wing-title {
  font-family: var(--serif);
  font-size: 44rpx;
  letter-spacing: 16rpx;
  padding-right: 16rpx;
  color: rgba(243, 234, 220, 0.92);
  font-weight: 600;
}
.wing-kicker {
  width: 140rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  white-space: nowrap;
  color: rgba(224, 181, 119, 0.65);
}
.wing-kicker:last-child {
  text-align: right;
}
.wing-kicker.ghost {
  visibility: hidden;
}
.wing-scroll {
  flex: 1;
  min-height: 0;
}
.wing-body {
  padding: 8rpx 40rpx calc(280rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.wing-title.slim {
  max-width: 400rpx;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  padding-right: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 滚动内容区 */
.page-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(212, 165, 116, 0.14);
  border-radius: 28rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 字体辅助 */
.text-gold {
  color: #e0b577;
}
.text-dim {
  color: rgba(240, 230, 216, 0.55);
}
.text-faint {
  color: rgba(240, 230, 216, 0.35);
}
.mono-num {
  font-variant-numeric: tabular-nums;
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #2b1d0f;
  background: linear-gradient(135deg, #f0c98a, #d4a574 55%, #c0955f);
  box-shadow: 0 12rpx 32rpx rgba(212, 165, 116, 0.28);
  border: none;
  line-height: 1;
}
.btn-primary::after {
  border: none;
}
.btn-primary.btn-disabled {
  opacity: 0.5;
}

/* 次要按钮 */
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 34rpx;
  color: #e0b577;
  background: rgba(212, 165, 116, 0.10);
  border: 1rpx solid rgba(212, 165, 116, 0.4);
  box-sizing: border-box;
}
.btn-ghost::after {
  border: none;
}

/* 按压反馈 */
.hover-dim {
  opacity: 0.7;
}

/* 状态胶囊 */
.status-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.status-chip.ongoing {
  color: #e0b577;
  background: rgba(224, 181, 119, 0.12);
  border: 1rpx solid rgba(224, 181, 119, 0.35);
}
.status-chip.completed {
  color: #9fe0b0;
  background: rgba(120, 220, 150, 0.10);
  border: 1rpx solid rgba(120, 220, 150, 0.35);
}
.status-chip.fulfilled {
  color: rgba(240, 230, 216, 0.6);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

/* 进度条 */
.progress-track {
  height: 14rpx;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #e8bd7d, #d4a574);
  transition: width 0.3s ease;
}

/* 自定义导航栏（88rpx 高，标题居中） */
.navbar {
  flex-shrink: 0;
  box-sizing: border-box;
}
.navbar-inner {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.navbar-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #f0e6d8;
  pointer-events: none;
  text-align: center;
}
.nav-slot {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  z-index: 1;
}
.nav-slot.nav-left {
  justify-content: flex-start;
}
.nav-slot.nav-right {
  justify-content: flex-end;
}

/* 返回按钮 */
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -16rpx;
}
.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #e6cfae;
  border-bottom: 4rpx solid #e6cfae;
  transform: rotate(45deg);
  box-sizing: border-box;
}

/* 页面标题文字 */
.nav-action {
  font-size: 34rpx;
  color: #e0b577;
  padding: 12rpx 8rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-emoji {
  font-size: 110rpx;
  line-height: 1.2;
  filter: grayscale(0.3) brightness(0.9);
}
.empty-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(240, 230, 216, 0.85);
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(240, 230, 216, 0.4);
}
